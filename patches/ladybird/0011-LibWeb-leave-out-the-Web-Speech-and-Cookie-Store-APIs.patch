diff --git a/Libraries/LibWeb/Embedder/Prune/CookieStore.cmake b/Libraries/LibWeb/Embedder/Prune/CookieStore.cmake
new file mode 100644
index 0000000000..eb471e8c91
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/CookieStore.cmake
@@ -0,0 +1,4 @@
+# karouka: the Cookie Store API. Pages render with no cookie jar behind them (no RequestClient), so
+# `cookieStore` would only ever see an empty store. `cookieStore` and CookieChangeEvent are not exposed;
+# `document.cookie` is unaffected.
+list(APPEND LIBWEB_PRUNED_FAMILIES CookieStore)
diff --git a/Libraries/LibWeb/Embedder/Prune/Speech.cmake b/Libraries/LibWeb/Embedder/Prune/Speech.cmake
new file mode 100644
index 0000000000..f02e70d663
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/Speech.cmake
@@ -0,0 +1,3 @@
+# karouka: the Web Speech API (speech synthesis and recognition). There is no audio output or input
+# in a texture renderer. `speechSynthesis` and the Speech* interfaces are not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES Speech)
