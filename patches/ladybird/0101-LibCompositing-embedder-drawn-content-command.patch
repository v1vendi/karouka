+bool DisplayListResourceStorage::draws_live_embedder_content(DisplayList const& display_list) const
+{
+    HashTable<u64> visited_display_lists;
+    return command_bytes_draw_live_embedder_content(display_list.command_bytes(), visited_display_lists);
+}
+
+bool DisplayListResourceStorage::command_bytes_draw_live_embedder_content(ReadonlyBytes command_bytes, HashTable<u64>& visited_display_lists) const
+{
+    bool draws = false;
+    DisplayList::for_each_command_header(command_bytes, [&](DisplayListCommandHeader const& header, ReadonlyBytes payload) {
+        if (draws)
+            return;
+        visit_display_list_command(header.command_type, payload, [&](auto const& command) {
+            using Command = RemoveCVReference<decltype(command)>;
+            if constexpr (IsSame<Command, DrawEmbedderContent>) {
+                draws = command.is_live;
+            } else if constexpr (IsSame<Command, PaintNestedDisplayList>) {
+                // Nested lists are immutable, so the verdict is kept with the list's cached rasters.
+                if (!has_display_list(command.display_list_id) || visited_display_lists.set(command.display_list_id.value()) != HashSetResult::InsertedNewEntry)
+                    return;
+                auto& resource = *m_display_list_cached_nested_rasters.ensure(command.display_list_id.value(), [&] {
+                    return make<DisplayListCachedNestedRasterResource>(nullptr);
+                });
+                if (!resource.draws_live_embedder_content.has_value())
+                    resource.draws_live_embedder_content = command_bytes_draw_live_embedder_content(display_list(command.display_list_id).command_bytes(), visited_display_lists);
+                draws = *resource.draws_live_embedder_content;
+            }
+            if (draws)
+                return;
+            for_each_command_byte_range_inside(command, payload, [&](ReadonlyBytes nested_records) {
+                draws = draws || command_bytes_draw_live_embedder_content(nested_records, visited_display_lists);
+            });
+        });
+    });
+    return draws;
+}
