+void DisplayListPlayerSkia::play_command(DrawEmbedderContent const& command)
+{
+    if (!m_embedder_content_resolver || command.dst_rect.is_empty())
+        return;
+    auto& canvas = surface().canvas();
+    auto save_count = canvas.save();
+    (*m_embedder_content_resolver)(command.content_id, command.dst_rect, canvas, m_caret_time_ns.has_value() ? *m_caret_time_ns : MonotonicTime::now().nanoseconds());
+    canvas.restoreToCount(save_count);
+}
