+// Pixels the embedder draws at replay: the player hands content_id, the destination rect, its canvas and the frame's
+// time to the embedder's EmbedderContentResolver (DisplayListPlayerSkia::set_embedder_content_resolver), which paints
+// into dst_rect under the command's transform and clip. Nothing is painted without a resolver.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[repr(C)]
+pub struct DrawEmbedderContent {
+    pub dst_rect: FloatRect,
+    pub content_id: u64,
+    // NB: Live content changes with the frame's time while the command's bytes stay the same, so damage computation
+    //     treats a live command as changed in every frame, and a nested display list holding one is never cached.
+    pub is_live: bool,
+}
+ffi_bytes_fields!(DrawEmbedderContent {
+    dst_rect,
+    content_id,
+    is_live
+});
+
+impl DisplayListCommand for DrawEmbedderContent {
+    const COMMAND_TYPE: DisplayListCommandType = DisplayListCommandType::DrawEmbedderContent;
+    fn bounding_rect(&self) -> Option<IntRect> {
+        Some(enclosing_int_rect(self.dst_rect))
+    }
+}
