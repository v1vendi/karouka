diff --git a/Libraries/LibWeb/Embedder/WebFonts.cpp b/Libraries/LibWeb/Embedder/WebFonts.cpp
new file mode 100644
index 0000000000..2d206e4ebd
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/WebFonts.cpp
@@ -0,0 +1,24 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibWeb/Embedder/WebFonts.h>
+
+namespace Web::Embedder {
+
+static WebFontTypefaceCreatedCallback s_typeface_created;
+
+void set_web_font_typeface_created_callback(WebFontTypefaceCreatedCallback callback)
+{
+    s_typeface_created = callback;
+}
+
+void notify_web_font_typeface_created(Gfx::Typeface const& typeface)
+{
+    if (s_typeface_created)
+        s_typeface_created(typeface);
+}
+
+}
diff --git a/Libraries/LibWeb/Embedder/WebFonts.h b/Libraries/LibWeb/Embedder/WebFonts.h
new file mode 100644
index 0000000000..1d6460bcba
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/WebFonts.h
@@ -0,0 +1,26 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/Export.h>
+
+namespace Gfx {
+class Typeface;
+}
+
+namespace Web::Embedder {
+
+// Called on the thread that made it, as soon as a web font (an @font-face rule's, or a FontFace's from
+// URLs or a BufferSource) has loaded into a typeface, before any style or layout uses it. An embedder
+// can start work that depends on the font's glyphs (karouka warms the glyphs an earlier run drew with
+// it) while the document restyles and lays out.
+// The callback must not re-enter LibWeb. Null (the default) turns it off.
+using WebFontTypefaceCreatedCallback = void (*)(Gfx::Typeface const&);
+WEB_API void set_web_font_typeface_created_callback(WebFontTypefaceCreatedCallback);
+void notify_web_font_typeface_created(Gfx::Typeface const&);
+
+}
