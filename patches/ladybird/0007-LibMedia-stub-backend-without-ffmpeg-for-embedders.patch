     ../../Services/MediaServer/MediaServerEndpoint.h
 )
 
-ladybird_lib(LibMediaClient mediaclient)
+# karouka: with LADYBIRD_MEDIA_STUB (see LibMedia) this links statically into its users instead of
+# shipping as its own dylib. Without a MediaServer transport, Client::acquire() fails and callers
+# fall back to "cannot play".
+if (LADYBIRD_MEDIA_STUB)
+    ladybird_lib(LibMediaClient mediaclient TYPE STATIC)
+else()
+    ladybird_lib(LibMediaClient mediaclient)
+endif()
 target_link_libraries(LibMediaClient PRIVATE LibCore LibGfx LibIPC LibMedia)
