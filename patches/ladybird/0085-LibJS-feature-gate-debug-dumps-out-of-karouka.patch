From: Illia Komsa <ik@fungamer.co>
Subject: [PATCH] LibJS: feature-gate the debug dumps out of karouka

A new cargo feature, debug-dump, covers the native disassembler (iced-x86 / fARM64, now optional),
ast_dump and the bytecode dumper with its generated per-instruction dump. LibJS/CMakeLists.txt turns
it on unless KAROUKA_SOURCE_DIR is set. Without it rust_dump_bytecode and rust_parsed_program_ast_dump
stay as no-op FFI entry points, so RustIntegration.cpp is unchanged and the LibJS dump flags print
nothing.

---
diff --git a/Libraries/LibJS/CMakeLists.txt b/Libraries/LibJS/CMakeLists.txt
index e0525777af..69afd2842a 100644
--- a/Libraries/LibJS/CMakeLists.txt
+++ b/Libraries/LibJS/CMakeLists.txt
@@ -301,7 +301,13 @@ endif()
 
 target_link_libraries(LibJS PUBLIC JSClangPlugin)
 
-import_rust_crate(MANIFEST_PATH Rust/Cargo.toml CRATE_NAME libjs_rust FFI_HEADER RustFFI.h)
+# karouka has no use for the LibJS dump flags: its libjs_rust is built without the native disassembler,
+# ast_dump and the bytecode dumper.
+set(libjs_rust_features "")
+if (NOT KAROUKA_SOURCE_DIR)
+    list(APPEND libjs_rust_features debug-dump)
+endif()
+import_rust_crate(MANIFEST_PATH Rust/Cargo.toml CRATE_NAME libjs_rust FFI_HEADER RustFFI.h FEATURES ${libjs_rust_features})
 target_link_libraries(LibJS PRIVATE libjs_rust)
 if ((LINUX OR BSD) AND NOT BUILD_SHARED_LIBS)
     # Rust staticlibs each carry the same allocator shim symbols. LibJS can
diff --git a/Libraries/LibJS/Rust/Cargo.toml b/Libraries/LibJS/Rust/Cargo.toml
index 9b173a4df7..5f76cff052 100644
--- a/Libraries/LibJS/Rust/Cargo.toml
+++ b/Libraries/LibJS/Rust/Cargo.toml
@@ -18,10 +18,15 @@ indexmap = "2"
 foldhash = "0.1"
 
 [target.'cfg(target_arch = "x86_64")'.dependencies]
-iced-x86 = { version = "1.21", default-features = false, features = ["decoder", "intel", "std"] }
+iced-x86 = { version = "1.21", default-features = false, features = ["decoder", "intel", "std"], optional = true }
 
 [target.'cfg(target_arch = "aarch64")'.dependencies]
-farm64 = { package = "fARM64", version = "0.0.2", features = ["alloc"] }
+farm64 = { package = "fARM64", version = "0.0.2", features = ["alloc"], optional = true }
+
+# Bytecode and AST dumps (the LibJS dump flags): the native disassembler, ast_dump and the bytecode
+# dumper. Without it the dump entry points stay and print nothing.
+[features]
+debug-dump = ["dep:iced-x86", "dep:farm64"]
 
 [build-dependencies]
 cbindgen = "0.29"
