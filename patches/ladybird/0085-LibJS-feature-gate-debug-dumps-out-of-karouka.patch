+/// Without `debug-dump` no AST dump is produced: the out-parameters are cleared.
+#[cfg(not(feature = "debug-dump"))]
+unsafe fn write_ast_dump_output(
+    _program: &ast::Statement,
+    _function_table: &ast::FunctionTable,
+    _arena: &ast::AstArena,
+    output_ptr: *mut *mut u8,
+    output_len: *mut usize,
+) {
+    unsafe {
+        if output_ptr.is_null() || output_len.is_null() {
+            return;
+        }
+        *output_ptr = std::ptr::null_mut();
+        *output_len = 0;
+    }
