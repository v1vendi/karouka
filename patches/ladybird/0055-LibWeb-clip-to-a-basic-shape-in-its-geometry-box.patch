+    /// A clip-path's `<basic-shape> || <geometry-box>`: the shape, and the box keyword when one was given.
+    pub(crate) fn basic_shape_with_geometry_box(&self) -> Option<(&BasicShapeData, Option<u16>)> {
+        match self {
+            Self::BasicShape { shape } => Some((shape.as_ref(), None)),
+            Self::ValueList { values, .. } => match values.as_slice() {
+                [shape, geometry_box] => match (shape.data(), geometry_box.data()) {
+                    (Self::BasicShape { shape }, Self::Keyword { keyword }) => Some((shape.as_ref(), Some(*keyword))),
+                    _ => None,
+                },
+                _ => None,
+            },
+            _ => None,
+        }
+    }
