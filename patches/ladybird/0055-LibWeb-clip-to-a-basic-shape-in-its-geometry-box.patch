From: Illia Komsa <ik@fungamer.co>
Subject: [PATCH] LibWeb: clip to a basic shape in its geometry box

clip-path only parsed a lone <basic-shape>, so `polygon(...) border-box`
(css-masking's <basic-shape> || <geometry-box>) was an invalid
declaration and the element wasn't clipped at all. The shape's reference
box was always the border box.

Parse the shape with an optional <geometry-box> into a [shape, box]
value list, as shape-outside does, and lay the shape out in that box:
content, padding, border or margin box, with fill-box used as
content-box and stroke-box and view-box as border-box for boxes with a
CSS layout box. A lone <geometry-box> is still rejected.

Fixes WPT css/css-masking/clip-path/clip-path-polygon-007, -011, -012.
---
diff --git a/Libraries/LibWeb/Rust/src/css/parser/positions_shapes_parser.rs b/Libraries/LibWeb/Rust/src/css/parser/positions_shapes_parser.rs
index 880ee0a8da..f54853e6dc 100644
--- a/Libraries/LibWeb/Rust/src/css/parser/positions_shapes_parser.rs
+++ b/Libraries/LibWeb/Rust/src/css/parser/positions_shapes_parser.rs
@@ -1081,6 +1081,67 @@ fn parse_shape_outside(context: &ParseContext, property: u16, values: &[Componen
     }
 }
 
+const BASIC_SHAPE_FUNCTIONS: [&str; 8] = ["inset", "xywh", "rect", "circle", "ellipse", "polygon", "path", "shape"];
+
+// https://drafts.fxtf.org/css-masking/#typedef-geometry-box
+fn geometry_box(value: &ComponentValue) -> Option<StyleValueData> {
+    let ident = value.ident()?;
+    let parsed_keyword = keyword_from_ascii_case_insensitive(ident)?;
+    [
+        "content-box",
+        "padding-box",
+        "border-box",
+        "margin-box",
+        "fill-box",
+        "stroke-box",
+        "view-box",
+    ]
+    .iter()
+    .any(|accepted| equals_ascii_case_insensitive(ident, accepted.as_bytes()))
+    .then_some(StyleValueData::Keyword {
+        keyword: parsed_keyword,
+    })
+}
+
+// https://drafts.fxtf.org/css-masking/#the-clip-path
+// <basic-shape> || <geometry-box>, the shape first and the box second when both are given.
+// FIXME: A <geometry-box> alone (clip to that box) isn't supported; the caller leaves it to the generic parser,
+//        which rejects it.
+fn parse_clip_path_shape(context: &ParseContext, property: u16, values: &[ComponentValue]) -> Option<StyleValueData> {
+    let mut tokens = TokenStream::new(values);
+    let mut shape = None;
+    let mut box_value = None;
+    while tokens.has_next_token() {
+        tokens.discard_whitespace();
+        if !tokens.has_next_token() {
+            break;
+        }
+        if tokens.next_token().function().is_some() {
+            if shape.is_some() {
+                return None;
+            }
+            shape = Some(parse_basic_shape(
+                context,
+                property,
+                std::slice::from_ref(tokens.consume_a_token()),
+            )?);
+        } else {
+            if box_value.is_some() {
+                return None;
+            }
+            box_value = Some(geometry_box(tokens.consume_a_token())?);
+        }
+    }
+    match (shape?, box_value) {
+        (shape, Some(box_value)) => Some(StyleValueData::ValueList {
+            values: RetainedStyleValueDataList::from_retained_values(vec![retained(shape), retained(box_value)]),
+            separator: 0,
+            collapsible: false,
+        }),
+        (shape, None) => Some(shape),
+    }
+}
