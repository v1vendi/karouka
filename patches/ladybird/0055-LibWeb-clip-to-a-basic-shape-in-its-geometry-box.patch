+// https://drafts.fxtf.org/css-masking/#the-clip-path
+// The reference box of a <basic-shape> clip-path: the <geometry-box> given with it, border-box by default.
+// https://drafts.fxtf.org/css-masking/#typedef-geometry-box
+// For elements with associated CSS layout box, the used value for fill-box is content-box, and for stroke-box and
+// view-box it is border-box.
+// FIXME: SVG elements, which have no CSS layout box, should use their fill, stroke and viewport boxes.
+fn clip_path_reference_box_rect(
+    layout_arena: &impl PaintRead,
+    slot: NodeSlotId,
+    geometry_box: Option<u16>,
+) -> CssPixelRect {
+    match geometry_box {
+        Some(keyword::CONTENT_BOX | keyword::FILL_BOX) => paintable_geometry::absolute_rect(layout_arena, slot),
+        Some(keyword::PADDING_BOX) => paintable_geometry::absolute_padding_box_rect(layout_arena, slot),
+        Some(keyword::MARGIN_BOX) => {
+            let border_box = paintable_geometry::absolute_border_box_rect(layout_arena, slot);
+            let margin = paintable_geometry::committed_margin(layout_arena, slot);
+            CssPixelRect::new(
+                border_box.x - margin.left,
+                border_box.y - margin.top,
+                border_box.width + margin.left + margin.right,
+                border_box.height + margin.top + margin.bottom,
+            )
+        }
+        _ => paintable_geometry::absolute_border_box_rect(layout_arena, slot),
+    }
+}
