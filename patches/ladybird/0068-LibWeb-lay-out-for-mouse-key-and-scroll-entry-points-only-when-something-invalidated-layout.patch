diff --git a/Libraries/LibWeb/Layout/UpdateLayout.cpp b/Libraries/LibWeb/Layout/UpdateLayout.cpp
--- a/Libraries/LibWeb/Layout/UpdateLayout.cpp
+++ b/Libraries/LibWeb/Layout/UpdateLayout.cpp
@@ -148,9 +148,28 @@
         if (reason != UpdateLayoutReason::HTMLEventLoopRenderingUpdate && reason != UpdateLayoutReason::ChildDocumentStyleUpdate)
             flush_throttled_animation_style_update();
 
+        // AD-HOC: An embedded document's update lays out its embedding documents first when they wait for it (their
+        //         layout may resize the frame), so its update is skipped only when the whole embedding chain is clean,
+        //         as update_layout_if_needed_for_node() asks too.
+        auto embedding_document_chain_is_clean = [&] {
+            auto const* embedded_document = this;
+            while (auto embedded_navigable = embedded_document->navigable()) {
+                auto embedding_document = embedded_navigable->container_document();
+                if (!embedding_document || embedding_document.ptr() == embedded_document)
+                    return true;
+                // The embedding document's state is that document's own read.
+                Layout::ForcedReadScope embedding_read { *embedding_document };
+                if (!embedding_document->is_clean_for_layout_geometry_read(embedding_read))
+                    return false;
+                embedded_document = embedding_document.ptr();
+            }
+            return true;
+        };
+
         if (is_clean_for_layout_geometry_read(read)
             && !m_needs_scroll_container_resnap
-            && !m_scroll_state_query_containers.has_containers())
+            && !m_scroll_state_query_containers.has_containers()
+            && embedding_document_chain_is_clean())
             return false;
     }
 
