+    // A page whose root isolation effect sits over an opacity group and nothing that reads the
+    // destination, replayed with the given blend mode on the group and the given command verdict.
+    fn root_isolation_layer_pushes(group_blend_mode: CompositingAndBlendingOperator, commands_read_destination: bool) -> Vec<f32> {
+        let mut tree = identity_tree();
+        let root_layer = effect_under(&mut tree, effects(1.0), EffectNodeIndex::NONE, ClipNodeIndex::NONE);
+        tree.root_isolation_effect = Some(root_layer);
+        let EffectNodeData::Effects(mut group_effects) = effects(0.5) else {
+            unreachable!()
+        };
+        group_effects.blend_mode = group_blend_mode;
+        let group = effect_under(&mut tree, EffectNodeData::Effects(group_effects), root_layer, ClipNodeIndex::NONE);
+        let runs = [
+            run(VISUAL_VIEWPORT_NODE_INDEX, ContextRef { effect: root_layer, ..ContextRef::default() }, visible_bounds()),
+            run(VISUAL_VIEWPORT_NODE_INDEX, ContextRef { effect: group, ..ContextRef::default() }, visible_bounds()),
+            run(VISUAL_VIEWPORT_NODE_INDEX, ContextRef { effect: root_layer, ..ContextRef::default() }, visible_bounds()),
+        ];
+        let mut plan = EffectClipPlan::new(&tree, &runs).unwrap();
+        plan.commands_read_destination = commands_read_destination;
+        let mut painter = RecordingPainter::new();
+        replay_display_list(&tree, &runs, &plan, &[], &mut painter);
+        let mut depth = 0i32;
+        let mut layers = Vec::new();
+        for event in &painter.events {
+            match event {
+                PainterEvent::PushLayer(opacity) => {
+                    layers.push(*opacity);
+                    depth += 1;
+                }
+                PainterEvent::PushClip(_) | PainterEvent::PushMask(_) | PainterEvent::PushPlaneClip(_) => depth += 1,
+                PainterEvent::Pop | PainterEvent::PopMask(_) => depth -= 1,
+                _ => {}
+            }
+        }
+        assert_eq!(depth, 0, "every push is popped");
+        assert_eq!(
+            painter.events.iter().filter(|event| matches!(event, PainterEvent::Run(_))).count(),
+            runs.len()
+        );
+        layers
+    }
+
+    #[test]
+    fn the_root_isolation_layer_is_skipped_when_nothing_reads_the_destination() {
+        assert_eq!(root_isolation_layer_pushes(CompositingAndBlendingOperator::Normal, false), vec![0.5]);
+    }
+
+    #[test]
+    fn a_blend_mode_or_a_destination_reading_draw_keeps_the_root_isolation_layer() {
+        assert_eq!(root_isolation_layer_pushes(CompositingAndBlendingOperator::Multiply, false), vec![1.0, 0.5]);
+        assert_eq!(root_isolation_layer_pushes(CompositingAndBlendingOperator::Normal, true), vec![1.0, 0.5]);
+    }
+
+    #[test]
+    fn only_top_level_non_normal_draws_read_the_destination() {
+        use crate::display_list::builder::DisplayListBuilder;
+        use crate::display_list::commands::FillRect;
+        let fill = |operator| FillRect {
+            rect: IntRect::new(0, 0, 10, 10),
+            color: libgfx_rust::Color::default(),
+            compositing_and_blending_operator: operator,
+            background_color_animation_effect: EffectNodeIndex::NONE,
+        };
+        let mut normal = DisplayListBuilder::new();
+        normal.append(&fill(CompositingAndBlendingOperator::Normal), &[], ContextRef::default());
+        assert!(!commands_read_destination(normal.bytes()));
+        let mut multiply = DisplayListBuilder::new();
+        multiply.append(&fill(CompositingAndBlendingOperator::Normal), &[], ContextRef::default());
+        multiply.append(&fill(CompositingAndBlendingOperator::Multiply), &[], ContextRef::default());
+        assert!(commands_read_destination(multiply.bytes()));
+        assert!(!commands_read_destination(&[]));
+    }
 }
