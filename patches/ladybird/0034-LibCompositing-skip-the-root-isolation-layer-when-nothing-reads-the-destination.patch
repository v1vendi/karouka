+// Whether a command recorded at the top level of a list (not inside an isolated group, whose own
+// layer bounds what its content reads) composites with an operator other than Normal, and so
+// reads what the canvas already holds. An image drawn against an isolated backdrop color blends
+// with that color instead. Nested display lists are not followed: a document's list carries its
+// own root isolation effect, which its own replay keeps whenever something in it reads the
+// destination.
+pub fn commands_read_destination(bytes: &[u8]) -> bool {
+    let mut reads = false;
+    for_each_command(bytes, |header, _, payload| {
+        if reads {
+            return;
+        }
+        let (operator, blends_with_isolated_backdrop_color) = match header.command_type {
+            DisplayListCommandType::FillRect => (read_command::<FillRect>(payload).compositing_and_blending_operator, false),
+            DisplayListCommandType::FillPath => (read_command::<FillPath>(payload).compositing_and_blending_operator, false),
+            DisplayListCommandType::DrawScaledDecodedImageFrame => {
+                let command = read_command::<DrawScaledDecodedImageFrame>(payload);
+                (command.compositing_and_blending_operator, command.isolated_backdrop_color.has_value)
+            }
+            DisplayListCommandType::DrawRepeatedDecodedImageFrame => {
+                let command = read_command::<DrawRepeatedDecodedImageFrame>(payload);
+                (command.compositing_and_blending_operator, command.isolated_backdrop_color.has_value)
+            }
+            DisplayListCommandType::DrawRepeatedTile => {
+                (read_command::<DrawRepeatedTile>(payload).compositing_and_blending_operator, false)
+            }
+            DisplayListCommandType::PaintLinearGradient => {
+                (read_command::<PaintLinearGradient>(payload).compositing_and_blending_operator, false)
+            }
+            DisplayListCommandType::PaintRadialGradient => {
+                (read_command::<PaintRadialGradient>(payload).compositing_and_blending_operator, false)
+            }
+            DisplayListCommandType::PaintConicGradient => {
+                (read_command::<PaintConicGradient>(payload).compositing_and_blending_operator, false)
+            }
+            DisplayListCommandType::DrawIsolatedGroup => {
+                (read_command::<DrawIsolatedGroup>(payload).compositing_and_blending_operator, false)
+            }
+            _ => return,
+        };
+        reads = operator != CompositingAndBlendingOperator::Normal && !blends_with_isolated_backdrop_color;
+    });
+    reads
+}
