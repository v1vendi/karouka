+/// Up to 15 UTF-16 code units stored in place, for the tokens of short inputs (property values)
+/// that keep no shared storage.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct InlineUnits {
+    units: [u16; InlineUnits::CAPACITY],
+    length: InlineLength,
+}
+
+#[derive(Clone, Copy, Debug)]
+#[repr(u8)]
+enum InlineLength {
+    L0,
+    L1,
+    L2,
+    L3,
+    L4,
+    L5,
+    L6,
+    L7,
+    L8,
+    L9,
+    L10,
+    L11,
+    L12,
+    L13,
+    L14,
+    L15,
+}
+
+impl InlineUnits {
+    const CAPACITY: usize = 15;
+    const LENGTHS: [InlineLength; Self::CAPACITY + 1] = {
+        use InlineLength::*;
+        [L0, L1, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11, L12, L13, L14, L15]
+    };
+
+    fn new(value: &[u16]) -> Option<Self> {
+        let length = *Self::LENGTHS.get(value.len())?;
+        let mut units = [0; Self::CAPACITY];
+        units[..value.len()].copy_from_slice(value);
+        Some(Self { units, length })
+    }
+
+    fn as_slice(&self) -> &[u16] {
+        &self.units[..self.length as usize]
+    }
+}
+
+/// A range of shared storage as 32-bit offsets, or `None` past `u32::MAX` (the caller then copies).
+fn compact_range(range: &Range<usize>) -> Option<Range<u32>> {
+    Some(u32::try_from(range.start).ok()?..u32::try_from(range.end).ok()?)
+}
+
+fn expand_range(range: &Range<u32>) -> Range<usize> {
+    range.start as usize..range.end as usize
+}
+
