+/// thousands of tokens and component values, so both are kept small: a `ParserString` is 32 bytes
+/// (the inline string's length is an enum with 16 values, whose unused values hold the variant),
+/// a `ParserSource` 24 (shared ranges are 32-bit), a `ParserToken` 88.
+const _: () = assert!(std::mem::size_of::<ParserString>() == 32);
+const _: () = assert!(std::mem::size_of::<ParserSource>() == 24);
+const _: () = assert!(std::mem::size_of::<ParserToken>() == 88);
