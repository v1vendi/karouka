From: Illia Komsa <ik@fungamer.co>
Subject: [PATCH] LibWeb: leave out SubtleCrypto

A LIBWEB_PRUNE_WEB_APIS build (karouka) leaves out WebCrypto's
SubtleCrypto and CryptoKey, with CryptoAlgorithms and CryptoBindings
behind them: about 1.1 MB of code, and LibCrypto's only users of OpenSSL.
`crypto.subtle` doesn't exist, as in a browser without it;
crypto.getRandomValues() and crypto.randomUUID() stay. Structured
serialization drops CryptoKey and its key type and usage encodings.

---
diff --git a/Libraries/LibWeb/Crypto/Crypto.cpp b/Libraries/LibWeb/Crypto/Crypto.cpp
index 12448e0ba0..e9d52b0d4f 100644
--- a/Libraries/LibWeb/Crypto/Crypto.cpp
+++ b/Libraries/LibWeb/Crypto/Crypto.cpp
@@ -10,7 +10,9 @@
 #include <LibGC/Heap.h>
 #include <LibJS/Runtime/TypedArray.h>
 #include <LibWeb/Crypto/Crypto.h>
-#include <LibWeb/Crypto/SubtleCrypto.h>
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
+#    include <LibWeb/Crypto/SubtleCrypto.h>
+#endif
 #include <LibWeb/WebIDL/Buffers.h>
 #include <LibWeb/WebIDL/QuotaExceededError.h>
 
@@ -24,7 +26,9 @@ GC::Ref<Crypto> Crypto::create()
 }
 
 Crypto::Crypto()
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
     : m_subtle(SubtleCrypto::create())
+#endif
 {
 }
 
@@ -33,13 +37,17 @@ Crypto::~Crypto() = default;
 void Crypto::visit_edges(GC::Cell::Visitor& visitor)
 {
     Base::visit_edges(visitor);
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
     visitor.visit(m_subtle);
+#endif
 }
 
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
 GC::Ref<SubtleCrypto> Crypto::subtle() const
 {
     return *m_subtle;
 }
+#endif
 
 // https://w3c.github.io/webcrypto/#dfn-Crypto-method-getRandomValues
 WebIDL::ExceptionOr<WebIDL::ArrayBufferViewVariant> Crypto::get_random_values(WebIDL::ArrayBufferViewVariant array) const
diff --git a/Libraries/LibWeb/Crypto/Crypto.h b/Libraries/LibWeb/Crypto/Crypto.h
index 53e64aa177..95f686f537 100644
--- a/Libraries/LibWeb/Crypto/Crypto.h
+++ b/Libraries/LibWeb/Crypto/Crypto.h
@@ -7,8 +7,11 @@
 #pragma once
 
 #include <LibWeb/Bindings/Wrappable.h>
-#include <LibWeb/Crypto/SubtleCrypto.h>
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
+#    include <LibWeb/Crypto/SubtleCrypto.h>
+#endif
 #include <LibWeb/Export.h>
+#include <LibWeb/WebIDL/Buffers.h>
 #include <LibWeb/WebIDL/ExceptionOr.h>
 
 namespace Web::Crypto {
@@ -22,7 +25,9 @@ public:
 
     virtual ~Crypto() override;
 
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
     GC::Ref<SubtleCrypto> subtle() const;
+#endif
 
     WebIDL::ExceptionOr<WebIDL::ArrayBufferViewVariant> get_random_values(WebIDL::ArrayBufferViewVariant) const;
     Utf16String random_uuid() const;
@@ -33,7 +38,9 @@ protected:
 private:
     Crypto();
 
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
     GC::Ptr<SubtleCrypto> m_subtle;
+#endif
 };
 
 WEB_API String generate_random_uuid();
diff --git a/Libraries/LibWeb/Embedder/Prune/SubtleCrypto.cmake b/Libraries/LibWeb/Embedder/Prune/SubtleCrypto.cmake
new file mode 100644
index 0000000000..cba24e11ad
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/SubtleCrypto.cmake
@@ -0,0 +1,7 @@
+# karouka: WebCrypto's SubtleCrypto (`crypto.subtle`) and CryptoKey, with every algorithm behind them.
+# They are LibCrypto's only users of OpenSSL (LIBCRYPTO_COMMONCRYPTO, top-level CMakeLists.txt).
+# crypto.getRandomValues() and crypto.randomUUID() stay (Crypto/Crypto.cpp). SubtleCrypto is not a
+# directory, so this only defines LIBWEB_PRUNE_SUBTLECRYPTO.
+list(APPEND LIBWEB_PRUNED_FAMILIES SubtleCrypto)
+list(FILTER SOURCES EXCLUDE REGEX "^Crypto/(CryptoAlgorithms|CryptoBindings|CryptoKey|SubtleCrypto)\\.cpp$")
+list(APPEND LIBWEB_PRUNED_IDL Crypto/CryptoKey Crypto/SubtleCrypto)
diff --git a/Libraries/LibWeb/HTML/StructuredSerialize.cpp b/Libraries/LibWeb/HTML/StructuredSerialize.cpp
index 1a7f0e3061..554339ebf3 100644
