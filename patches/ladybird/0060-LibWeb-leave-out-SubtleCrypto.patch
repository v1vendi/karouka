@@ -62,7 +64,9 @@
 #include <LibWeb/Bindings/Transferable.h>
 #include <LibWeb/Bindings/TransformStream.h>
 #include <LibWeb/Bindings/WritableStream.h>
-#include <LibWeb/Crypto/CryptoKey.h>
+#ifndef LIBWEB_PRUNE_SUBTLECRYPTO
+#    include <LibWeb/Crypto/CryptoKey.h>
