--- /dev/null
+++ b/Libraries/LibWeb/Rust/src/css/style/lazy_user_agent_rules.rs
@@ -0,0 +1,287 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+//! A user-agent style rule whose every selector's subject compound requires something an element
+//! can only have once the document holds it matches nothing until that has happened. The
+//! requirements are triggers of two kinds:
+//!
+//! - an element type: a type selector, `:is()` or `:where()` of such selectors, `:heading` (h1-h6),
+//!   the link pseudo-classes (a and area), `:autofill` (input, select and textarea) or the
+//!   `::file-selector-button` of an input;
+//! - an attribute: an attribute selector, or `:popover-open`, which only an element with a
+//!   `popover` attribute matches.
+//!
+//! Most of them name elements or attributes a document never holds (an empty page has html, head
+//! and body and no attributes), so a document publishes such a rule only once one of its triggers
+//! has happened: before that, its selector program, dispatch entries and declarations cost the
+//! engine memory and every rebuild of the user-agent scope's dispatch time, and decide nothing.
+//!
+//! The host notes the ASCII-lowercase local name of every element that arrives in its style engine
+//! and of every attribute it arrives with (`record_subtree_arrivals`), and of every attribute that
+//! appears on an element that has arrived (`record_element_attribute_changed`). A whole-sheet
+//! compilation of a user-agent sheet publishes a rule none of whose triggers has happened yet as
+//! nothing, and keeps it under each of its triggers. When one of them happens, the host compiles
+//! the rule into its place in the sheet, the way an inserted CSSOM rule is compiled, and the engine
+//! invalidates for it as for one.
+
+use crate::css::retained_fly_string::RetainedUtf16FlyString;
+use crate::css::selector::{
+    Combinator, CompiledSelector, CompoundSelector, PseudoClassType, PseudoElementType, SimpleSelector,
+};
+use crate::css::selector_parser::RustParsedSelectorList;
+use crate::css::style::engine_calls::document_host;
+use crate::fast_hash::FastMap;
+use crate::render_state::DocumentHost;
+use std::cell::RefCell;
+use std::ffi::c_void;
+use std::sync::Arc;
+
+/// What has to happen in a document before a kept-back rule can match: an element of a lowercase
+/// local name arrives, or an attribute of a lowercase local name appears on an element, by raw
+/// fly-string identity.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum Trigger {
+    Element(usize),
+    Attribute(usize),
+}
+
+#[derive(Default)]
+struct State {
+    /// The host's numbers of the sheets that cascade in the user-agent origin.
+    user_agent_sheets: Vec<u32>,
+    /// The triggers that have happened. The names are retained, so no identity here is ever given
+    /// to another name.
+    happened: FastMap<Trigger, RetainedUtf16FlyString>,
+    /// The rules kept back, by each trigger of theirs: the sheet and native identity, and the name
+    /// that keeps the trigger's identity alive.
+    deferred: FastMap<Trigger, (RetainedUtf16FlyString, Vec<(u32, u64)>)>,
+}
+
+/// What a document host keeps of the user-agent rules it has not published yet.
+#[derive(Default)]
+pub(crate) struct LazyUserAgentRules {
+    state: RefCell<State>,
+}
+
+impl LazyUserAgentRules {
+    /// Notes that the host numbered a sheet of the user-agent origin `sheet`.
+    pub(crate) fn note_user_agent_sheet(&self, sheet: u32) {
+        self.state.borrow_mut().user_agent_sheets.push(sheet);
+    }
+
+    /// Whether a whole-sheet compilation of `sheet` may keep rules back.
+    pub(crate) fn defers_rules_of(&self, sheet: u32) -> bool {
+        self.state.borrow().user_agent_sheets.contains(&sheet)
+    }
+
+    /// Keeps the rule `identity` of `sheet`, whose selectors are `selectors`, back until one of its
+    /// triggers happens, and answers whether it did. A rule some selector of which has no trigger
+    /// in its subject compound, or one of whose triggers has happened, is published.
+    pub(crate) fn defer(&self, sheet: u32, identity: u64, selectors: &RustParsedSelectorList) -> bool {
+        let Some(triggers) = subject_triggers(selectors) else {
+            return false;
+        };
+        let mut state = self.state.borrow_mut();
+        if triggers
+            .iter()
+            .any(|(trigger, _)| state.happened.contains_key(trigger))
+        {
+            return false;
+        }
+        for (trigger, name) in triggers {
+            let (_, rules) = state
+                .deferred
+                .entry(trigger)
+                .or_insert_with(|| (name, Vec::new()));
+            if !rules.contains(&(sheet, identity)) {
+                rules.push((sheet, identity));
+            }
+        }
+        true
+    }
+
+    /// Notes that the triggers `triggers` happened, and answers the rules kept back for the ones
+    /// that had not happened before, in no particular order and each once, leaving out the rules
+    /// the host has published since.
+    ///
+    /// # Safety
+    /// The raw identity in each trigger must be a live fly string.
+    unsafe fn take_for(&self, host: &DocumentHost, triggers: impl Iterator<Item = Trigger>) -> Vec<(u32, u64)> {
+        let mut state = self.state.borrow_mut();
+        let mut taken = Vec::new();
+        for trigger in triggers {
+            let (Trigger::Element(raw) | Trigger::Attribute(raw)) = trigger;
+            if raw == 0 || state.happened.contains_key(&trigger) {
+                continue;
+            }
+            // SAFETY: Guaranteed by the caller; this retains the identity.
+            state
+                .happened
+                .insert(trigger, unsafe { RetainedUtf16FlyString::from_borrowed_raw(raw) });
+            if let Some((_, rules)) = state.deferred.remove(&trigger) {
+                taken.extend(rules);
+            }
+        }
+        if taken.is_empty() {
+            return taken;
+        }
+        taken.sort_unstable();
+        taken.dedup();
+        let published = host.published_rules();
+        taken.retain(|&(sheet, identity)| !published.contains(sheet, identity));
+        taken
+    }
+}
+
+fn retained_name(name: &str) -> RetainedUtf16FlyString {
+    RetainedUtf16FlyString::from_utf16(&name.encode_utf16().collect::<Vec<_>>())
+}
+
+fn add_element_names(names: &[&str], triggers: &mut Vec<(Trigger, RetainedUtf16FlyString)>) {
+    triggers.extend(names.iter().map(|name| {
+        let name = retained_name(name);
+        (Trigger::Element(name.raw()), name)
+    }));
+}
+
+/// The triggers of the subject compounds of `selectors`: an element any of them matches has one of
+/// these names or attributes. None where some selector's subject compound has none.
+fn subject_triggers(selectors: &RustParsedSelectorList) -> Option<Vec<(Trigger, RetainedUtf16FlyString)>> {
+    let mut triggers = Vec::new();
+    selector_list_triggers(&selectors.selectors, &mut triggers).then_some(triggers)
+}
+
+fn selector_list_triggers(
+    selectors: &[Arc<CompiledSelector>],
+    triggers: &mut Vec<(Trigger, RetainedUtf16FlyString)>,
+) -> bool {
+    !selectors.is_empty()
+        && selectors.iter().all(|selector| {
+            // A pseudo-element's compounds follow the compound of the element it belongs to.
+            let Some(subject) = selector
+                .compound_selectors
+                .iter()
+                .rev()
+                .find(|compound| compound.combinator != Combinator::PseudoElement)
+            else {
+                return false;
+            };
+            if compound_triggers(subject, triggers) {
+                return true;
+            }
+            // Only an input has a file selector button, in its shadow tree, which arrives with or after it.
+            if selector.target_pseudo_element == Some(PseudoElementType::FileSelectorButton) {
+                add_element_names(&["input"], triggers);
+                return true;
+            }
+            false
+        })
+}
+
+/// Adds the triggers of `compound`, answering whether it has any. One requirement of a compound is
+/// enough: an element that matches it meets them all. A type selector is preferred, then an
+/// attribute selector, then the pseudo-classes only some elements can match.
+fn compound_triggers(compound: &CompoundSelector, triggers: &mut Vec<(Trigger, RetainedUtf16FlyString)>) -> bool {
+    for simple in &compound.simple_selectors {
+        if let SimpleSelector::TagName(name) = simple
+            && let Some(raw) = name.lowercase_name.optional_raw()
+        {
+            triggers.push((Trigger::Element(raw), name.lowercase_name.clone()));
+            return true;
+        }
+    }
+    for simple in &compound.simple_selectors {
+        // Every attribute selector requires the attribute, whatever it asks of its value.
+        if let SimpleSelector::Attribute(attribute) = simple
+            && let Some(raw) = attribute.qualified_name.lowercase_name.optional_raw()
+        {
+            triggers.push((Trigger::Attribute(raw), attribute.qualified_name.lowercase_name.clone()));
+            return true;
+        }
+    }
+    compound.simple_selectors.iter().any(|simple| {
+        let SimpleSelector::PseudoClass(pseudo_class) = simple else {
+            return false;
+        };
+        match pseudo_class.pseudo_class {
+            PseudoClassType::Is | PseudoClassType::Where => {
+                let mut arguments = Vec::new();
+                let required = selector_list_triggers(&pseudo_class.argument_selector_list, &mut arguments);
+                if required {
+                    triggers.extend(arguments);
+                }
+                required
+            }
+            // Only the HTML heading elements, whose heading level is the fact it reads.
+            PseudoClassType::Heading => {
+                add_element_names(&["h1", "h2", "h3", "h4", "h5", "h6"], triggers);
+                true
+            }
+            // Only a, area and SVG a elements with an href are links (`Element::matches_link_pseudo_class`).
+            PseudoClassType::AnyLink
+            | PseudoClassType::Link
+            | PseudoClassType::LocalLink
+            | PseudoClassType::Visited => {
+                add_element_names(&["a", "area"], triggers);
+                true
+            }
+            // Only form controls autofill.
+            PseudoClassType::Autofill => {
+                add_element_names(&["input", "select", "textarea"], triggers);
+                true
+            }
+            // Only an element with a popover attribute is an open popover.
+            PseudoClassType::PopoverOpen => {
+                let name = retained_name("popover");
+                triggers.push((Trigger::Attribute(name.raw()), name));
+                true
+            }
+            _ => false,
+        }
+    })
+}
+
+/// Notes the arrival in the style engine of elements of the ASCII-lowercase local names `names`
+/// and the appearance on elements that have arrived of attributes of the ASCII-lowercase local
+/// names `attribute_names` (raw `Utf16FlyString` identities), and calls `publish` with the host's
+/// sheet number and the native identity of each user-agent rule kept back for one of them, which
+/// the host compiles.
+///
+/// # Safety
+/// `host` must be a live document host, on its document's thread. `names` and `attribute_names`
+/// must point at `count` and `attribute_count` live fly-string identities. `publish` must not reach
+/// this document's lazy rules.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn karouka_style_engine_take_user_agent_rules_for_arrivals(
+    host: *const DocumentHost,
+    names: *const usize,
+    count: usize,
+    attribute_names: *const usize,
+    attribute_count: usize,
+    context: *mut c_void,
+    publish: unsafe extern "C" fn(*mut c_void, u32, u64),
+) {
+    // SAFETY: Guaranteed by the caller.
+    let host = unsafe { document_host(host) };
+    let slice = |pointer: *const usize, count: usize| {
+        if count == 0 {
+            &[][..]
+        } else {
+            // SAFETY: Guaranteed by the caller.
+            unsafe { std::slice::from_raw_parts(pointer, count) }
+        }
+    };
+    let triggers = slice(names, count)
+        .iter()
+        .map(|&raw| Trigger::Element(raw))
+        .chain(slice(attribute_names, attribute_count).iter().map(|&raw| Trigger::Attribute(raw)));
+    // SAFETY: Guaranteed by the caller.
+    let taken = unsafe { host.published_rules().lazy_user_agent_rules().take_for(host, triggers) };
+    for (sheet, identity) in taken {
+        // SAFETY: Guaranteed by the caller.
+        unsafe { publish(context, sheet, identity) };
+    }
+}
