+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/Export.h>
+
+namespace Web::Embedder {
+
+// Waits until the jobs handed to the StyleLayout and Paint threads are done, then stops those
+// threads for the rest of the process: no layout or paint runs after it, and anything that waits for
+// one waits forever. For an embedder that is done with LibWeb for good, so that a job still running
+// on a stage thread does not race exit()'s static destructors (Skia's typeface cache among them).
+WEB_API void halt_stage_threads();
+
+}
