-if (LADYBIRD_MEDIA_STUB)
+
+# karouka: a pruned LibWeb (Libraries/LibWeb/CMakeLists.txt) builds without the browser's services,
+# UI, LibWebView, LibDatabase, the js REPL and LibCompositing's WebGL command stream, so it needs
+# none of the ports only they use: the default "browser" feature of vcpkg.json (curl and its
+# http2/http3 stack, libproxy, sqlite3, sdl3, libedit, pdf.js, ANGLE). Declared here for the same
+# reason as LADYBIRD_MEDIA_STUB.
+if (KAROUKA_SOURCE_DIR)
+    set(LIBWEB_PRUNE_WEB_APIS_DEFAULT ON)
+else()
+    set(LIBWEB_PRUNE_WEB_APIS_DEFAULT OFF)
+endif()
+option(LIBWEB_PRUNE_WEB_APIS "Leave browser-only Web API families out of LibWeb" ${LIBWEB_PRUNE_WEB_APIS_DEFAULT})
+
+if (LADYBIRD_MEDIA_STUB OR LIBWEB_PRUNE_WEB_APIS)
     set(VCPKG_MANIFEST_NO_DEFAULT_FEATURES ON)
+    if (NOT LADYBIRD_MEDIA_STUB)
+        list(APPEND VCPKG_MANIFEST_FEATURES media)
+    endif()
+    if (NOT LIBWEB_PRUNE_WEB_APIS)
+        list(APPEND VCPKG_MANIFEST_FEATURES browser)
+    endif()
 endif()
 
