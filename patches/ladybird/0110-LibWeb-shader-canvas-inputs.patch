+static void resolve_shader_canvas_input(Embedder::ShaderArgument& argument, FunctionStyleValue const& function, DOM::Document const* document, DOM::Element const* painted_element)
+{
+    using Refusal = Embedder::ShaderArgument::CanvasRefusal;
