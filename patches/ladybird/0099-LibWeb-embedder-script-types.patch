@@ -0,0 +1,75 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/String.h>
+#include <AK/Utf16View.h>
+#include <LibURL/URL.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+#include <LibWeb/HTML/Scripting/Fetching.h>
+#include <LibWeb/HTML/Scripting/Script.h>
+
+namespace Web::Embedder {
+
+// A script of an embedder script type: its MIME type essence, its source text as UTF-8, the URL
+// it came from (the document's for an inline script, the response's for src=) and the line its
+// text starts on in that URL's resource (an inline script's line in the document, 1 for src=).
+class WEB_API EmbedderScript final : public HTML::Script {
+    GC_CELL(EmbedderScript, HTML::Script);
+    GC_DECLARE_ALLOCATOR(EmbedderScript);
+
+public:
+    virtual ~EmbedderScript() override;
+
+    String const& mime_essence() const { return m_mime_essence; }
+    String const& source_text() const { return m_source_text; }
+    URL::URL const& url() const { return m_url; }
+    size_t line() const { return m_line; }
+
+    static GC::Ref<EmbedderScript> create(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject&, URL::URL base_url);
+
+private:
+    EmbedderScript(String mime_essence, String source_text, URL::URL url, size_t line, HTML::EnvironmentSettingsObject&, URL::URL base_url);
+
+    String m_mime_essence;
+    String m_source_text;
+    URL::URL m_url;
+    size_t m_line { 1 };
+};
+
+// Script types the embedder runs itself, such as <script type="text/python">. A script whose type
+// is not a JavaScript MIME type, "module" or "importmap", and whose type's MIME essence the handler
+// accepts for the element's document, follows the classic-script path of "prepare the script
+// element": parser-blocking, or async or defer ordered, src= fetched as a no-cors "script" request
+// (decoded as UTF-8 whatever the charset), currentScript set while it runs, load after a src=
+// script runs. In place of evaluating JavaScript, the element runs the handler; a handler that
+// fails fires error at the element (and no load). The checks of a classic script still apply
+// (nomodule, event/for, CSP for inline text). A type the handler doesn't accept stays ignored.
+class WEB_API ScriptTypeHandler {
+public:
+    virtual ~ScriptTypeHandler();
+
+    // `mime_essence` is the type's MIME essence, lowercase ("text/python" for "Text/Python;v=3").
+    virtual bool handles_script_type(DOM::Document const&, StringView mime_essence) = 0;
+
+    // Runs inside the document's realm, between "prepare to run script" and "clean up after running
+    // script" (a microtask checkpoint follows when no other script is on the stack).
+    // Returns false when the script failed.
+    virtual bool run_script(HTML::HTMLScriptElement&, EmbedderScript const&) = 0;
+};
+
+// One handler for the process; null (the default) leaves every non-JavaScript type ignored.
+WEB_API void set_script_type_handler(ScriptTypeHandler*);
+
+// HTMLScriptElement's side.
+Optional<String> embedder_script_type_essence(DOM::Document const&, Utf16View script_block_type);
+GC::Ref<EmbedderScript> create_inline_embedder_script(HTML::HTMLScriptElement&, String mime_essence, Utf16View source_text, size_t line);
+void fetch_embedder_script(HTML::HTMLScriptElement&, String mime_essence, URL::URL const&, HTML::EnvironmentSettingsObject&, HTML::ScriptFetchOptions, HTML::OnFetchScriptComplete);
+bool run_embedder_script(HTML::HTMLScriptElement&, EmbedderScript&);
+
+}
