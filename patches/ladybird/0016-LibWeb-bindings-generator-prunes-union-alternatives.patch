+def _without_pruned_alternatives(type_: IDLType, pruned: Set[str]) -> IDLType:
+    if isinstance(type_, IDLUnionType):
+        member_types = [_without_pruned_alternatives(member_type, pruned) for member_type in type_.member_types]
+        kept_member_types = [
+            member_type
+            for member_type in member_types
+            if not any(nested_type.name in pruned for nested_type in member_type.nested_types())
+        ]
+        if kept_member_types:
+            member_types = kept_member_types
+        return IDLUnionType(member_types, type_.nullable, type_.extended_attributes)
+    if isinstance(type_, IDLParameterizedType):
+        return IDLParameterizedType(
+            type_.name,
+            [_without_pruned_alternatives(parameter, pruned) for parameter in type_.parameters],
+            type_.nullable,
+            type_.extended_attributes,
+        )
+    return type_
+
+
 def _names_pruned(type_: Optional[IDLType], pruned: Set[str]) -> bool:
     if type_ is None:
         return False
+    type_ = _without_pruned_alternatives(type_, pruned)
     return any(nested_type.name in pruned for nested_type in type_.nested_types())
 
 
