diff --git a/Libraries/LibWeb/Embedder/Prune/MediaCapture.cmake b/Libraries/LibWeb/Embedder/Prune/MediaCapture.cmake
new file mode 100644
index 0000000000..07de204ceb
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/MediaCapture.cmake
@@ -0,0 +1,6 @@
+# karouka: Media Capture and Streams. There are no cameras or microphones to capture from.
+# `navigator.mediaDevices` and `MediaStream` are not exposed, `srcObject` takes no MediaStream, and the
+# Web Audio nodes that read or write a MediaStream (createMediaStreamSource/Destination) go with it.
+list(APPEND LIBWEB_PRUNED_FAMILIES MediaCapture)
+list(FILTER SOURCES EXCLUDE REGEX "^WebAudio/(MediaStreamAudio(Source|Destination)Node|Rendering/MediaStream(Source|Destination)RenderNode)\\.cpp$")
+list(APPEND LIBWEB_PRUNED_IDL WebAudio/MediaStreamAudioDestinationNode WebAudio/MediaStreamAudioSourceNode)
diff --git a/Libraries/LibWeb/Embedder/Prune/MediaSourceExtensions.cmake b/Libraries/LibWeb/Embedder/Prune/MediaSourceExtensions.cmake
new file mode 100644
index 0000000000..eab78ca92a
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/MediaSourceExtensions.cmake
@@ -0,0 +1,4 @@
+# karouka: Media Source Extensions. Pages render without a media server, so no media element can play a
+# MediaSource. `MediaSource`, `ManagedMediaSource` and `SourceBuffer` are not exposed, `srcObject` takes only
+# a Blob, `URL.createObjectURL` only a Blob, and MediaCapabilities answers "media-source" queries unsupported.
+list(APPEND LIBWEB_PRUNED_FAMILIES MediaSourceExtensions)
