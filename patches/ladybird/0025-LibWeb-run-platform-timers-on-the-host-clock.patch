 void Timer::start()
 {
-    m_timer->start();
-    m_activity_root.take(*this);
+    start(m_timer->interval());
 }
 
 void Timer::start(int interval_ms)
 {
-    m_timer->start(interval_ms);
+    if (!is_active()) {
+        if (runs_on_host_clock(interval_ms)) {
+            m_timer->set_interval(interval_ms);
+            Embedder::schedule_on_host_clock(*this, interval_ms, !m_timer->is_single_shot(), [this] {
+                if (m_timer->on_timeout)
+                    m_timer->on_timeout();
+            });
+        } else {
+            m_timer->start(interval_ms);
+        }
+    }
     m_activity_root.take(*this);
 }
 
