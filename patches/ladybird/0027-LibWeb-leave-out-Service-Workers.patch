+++ b/Libraries/LibWeb/Embedder/Prune/ServiceWorker.cmake
@@ -0,0 +1,5 @@
+# karouka: Service Workers and the Cache API. Pages render from local files with no network and no
+# profile directory, so there is nothing to intercept fetches for and nowhere to keep caches.
+# `navigator.serviceWorker` and `caches` are not exposed, and environment settings objects keep no
+# service worker registration or worker object maps.
+list(APPEND LIBWEB_PRUNED_FAMILIES ServiceWorker)
