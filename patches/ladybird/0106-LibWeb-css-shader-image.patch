+/// karouka: the `url_type` of a `shader(<url>)` image, beside the C++ URL::Type values (url() 0,
+/// src() 1) it otherwise carries. The URL names the shader's source (data: or file: only).
+pub(crate) const SHADER_URL_IMAGE_TYPE: u8 = 2;
+/// karouka: the `url_type` of a `shader(<string>)` image, whose `url` is the shader's source text.
+pub(crate) const SHADER_SOURCE_IMAGE_TYPE: u8 = 3;
+
+/// karouka: `shader( <url> | <string> )`, an image whose pixels an SkSL shader paints
+/// (docs/ENGINE.md). Uniform arguments aren't supported yet.
+fn parse_shader(context: &ParseContext, arguments: &[ComponentValue]) -> Option<StyleValueData> {
+    if context.contains_attr_tainted_values {
+        return None;
+    }
+    let mut arguments = arguments.iter().filter(|value| !value.is_whitespace());
+    let source = arguments.next()?;
+    if arguments.next().is_some() {
+        return None;
+    }
+    if let Some(string) = source.string() {
+        return Some(StyleValueData::Image {
+            url: RetainedString::from_utf16(string)?,
+            url_type: SHADER_SOURCE_IMAGE_TYPE,
+            url_modifiers: RetainedRequestUrlModifierList::from_retained_modifiers(Vec::new()),
+            resource_context: image_resource_context(context)?,
+        });
+    }
+    let StyleValueData::Url {
+        url,
+        url_type: 0,
+        modifiers,
+    } = parse_url_value(context, source)?
+    else {
+        return None;
+    };
+    if url.is_fragment() {
+        return None;
+    }
+    Some(StyleValueData::Image {
+        url,
+        url_type: SHADER_URL_IMAGE_TYPE,
+        url_modifiers: modifiers,
+        resource_context: image_resource_context(context)?,
+    })
+}
