+// A shader(<string>) image loads its source as a data: URL, so that equal sources share one request.
+static Optional<::URL::URL> shader_source_data_url(Utf16View source)
+{
+    auto utf8 = source.to_utf8();
+    if (utf8.is_error())
+        return {};
+    auto base64 = encode_base64(utf8.value().bytes());
+    if (base64.is_error())
+        return {};
+    return DOMURL::parse(Utf16String::formatted("data:text/plain;charset=utf-8;base64,{}", base64.value()));
+}
