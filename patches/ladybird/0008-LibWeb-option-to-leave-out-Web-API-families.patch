diff --git a/Meta/Generators/libweb_bindings/pruning.py b/Meta/Generators/libweb_bindings/pruning.py
new file mode 100644
index 0000000000..1b3b2f83b6
--- /dev/null
+++ b/Meta/Generators/libweb_bindings/pruning.py
@@ -0,0 +1,130 @@
+# karouka: embedder builds can leave whole Web API families out of LibWeb (LibWeb/CMakeLists.txt,
+# LIBWEB_PRUNE_WEB_APIS). The IDL files of a pruned family are parsed but generate nothing, and the
+# members of the remaining IDL files that name one of the family's definitions are dropped: an
+# attribute, operation or constant whose type mentions it, a dictionary member, an `includes` of one
+# of its mixins. `navigator.serial` then simply does not exist, the same as in a browser without it.
+
+from dataclasses import replace
+from typing import Iterable
+from typing import List
+from typing import Optional
+from typing import Set
+
+from Utils.webidl_parser import Dictionary
+from Utils.webidl_parser import IDLType
+from Utils.webidl_parser import Interface
+from Utils.webidl_parser import Module
+from Utils.webidl_parser import OperationParameter
+
+
+def pruned_definition_names(pruned_modules: Iterable[Module]) -> Set[str]:
+    # Only the definitions a pruned module owns. Its partial interfaces, mixins and dictionaries
+    # extend definitions that stay (Window, Navigator, ...); they just disappear with the module.
+    names: Set[str] = set()
+    for module in pruned_modules:
+        if module.interface is not None:
+            names.add(module.interface.name)
+        names.update(mixin.name for mixin in module.mixins)
+        names.update(dictionary.name for dictionary in module.dictionaries)
+        names.update(enumeration.name for enumeration in module.enumerations)
+        names.update(callback_function.name for callback_function in module.callback_functions)
+        names.update(typedef.name for typedef in module.typedefs)
+    return names
+
+
+def _names_pruned(type_: Optional[IDLType], pruned: Set[str]) -> bool:
+    if type_ is None:
+        return False
+    return any(nested_type.name in pruned for nested_type in type_.nested_types())
+
+
+def _parameters_pruned(parameters: List[OperationParameter], pruned: Set[str]) -> bool:
+    return any(_names_pruned(parameter.type, pruned) for parameter in parameters)
+
+
+def _prune_interface(interface: Interface, pruned: Set[str]) -> Interface:
+    for declaration in (interface.iterable, interface.async_iterable, interface.maplike, interface.setlike):
+        if declaration is not None and any(
+            _names_pruned(getattr(declaration, field, None), pruned) for field in ("key_type", "value_type")
+        ):
+            raise RuntimeError(f"{interface.name} iterates over a pruned type; prune it too")
+    return replace(
+        interface,
+        constants=[constant for constant in interface.constants if not _names_pruned(constant.type, pruned)],
+        regular_attributes=[
+            attribute for attribute in interface.regular_attributes if not _names_pruned(attribute.type, pruned)
+        ],
+        static_attributes=[
+            attribute for attribute in interface.static_attributes if not _names_pruned(attribute.type, pruned)
+        ],
+        regular_operations=[
+            operation
+            for operation in interface.regular_operations
+            if not _names_pruned(operation.return_type, pruned)
+            and not _parameters_pruned(operation.parameters, pruned)
+        ],
+        static_operations=[
+            operation
+            for operation in interface.static_operations
+            if not _names_pruned(operation.return_type, pruned)
+            and not _parameters_pruned(operation.parameters, pruned)
+        ],
+        constructors=[
+            constructor
+            for constructor in interface.constructors
+            if not _parameters_pruned(constructor.parameters, pruned)
+        ],
+    )
+
+
+def _prune_dictionary(dictionary: Dictionary, pruned: Set[str]) -> Dictionary:
+    return replace(
+        dictionary,
+        members=[member for member in dictionary.members if not _names_pruned(member.type, pruned)],
+    )
+
+
+def prune_module(module: Module, pruned: Set[str]) -> Module:
+    if not pruned:
+        return module
+    return replace(
+        module,
+        interface=_prune_interface(module.interface, pruned) if module.interface is not None else None,
+        partial_interfaces=[_prune_interface(interface, pruned) for interface in module.partial_interfaces],
+        mixins=[_prune_interface(mixin, pruned) for mixin in module.mixins],
+        partial_mixins=[_prune_interface(mixin, pruned) for mixin in module.partial_mixins],
+        included_mixins=[
+            included_mixin for included_mixin in module.included_mixins if included_mixin.mixin_name not in pruned
+        ],
+        callback_functions=[
+            callback_function
+            for callback_function in module.callback_functions
+            if not _names_pruned(callback_function.return_type, pruned)
+            and not _parameters_pruned(callback_function.parameters, pruned)
+        ],
+        dictionaries=[_prune_dictionary(dictionary, pruned) for dictionary in module.dictionaries],
+        partial_dictionaries=[_prune_dictionary(dictionary, pruned) for dictionary in module.partial_dictionaries],
+        typedefs=[typedef for typedef in module.typedefs if not _names_pruned(typedef.type, pruned)],
+    )
+
+
+def close_over_aliases(pruned: Set[str], modules: Iterable[Module]) -> Set[str]:
+    # A typedef or callback that names a pruned definition goes too, and so does whatever names it.
+    modules = list(modules)
+    closed = set(pruned)
+    while True:
+        added = False
+        for module in modules:
+            for typedef in module.typedefs:
+                if typedef.name not in closed and _names_pruned(typedef.type, closed):
+                    closed.add(typedef.name)
+                    added = True
+            for callback_function in module.callback_functions:
+                if callback_function.name not in closed and (
+                    _names_pruned(callback_function.return_type, closed)
+                    or _parameters_pruned(callback_function.parameters, closed)
+                ):
+                    closed.add(callback_function.name)
+                    added = True
+        if not added:
+            return closed
