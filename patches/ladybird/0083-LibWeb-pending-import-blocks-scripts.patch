diff --git a/Libraries/LibWeb/DOM/Document.cpp b/Libraries/LibWeb/DOM/Document.cpp
--- a/Libraries/LibWeb/DOM/Document.cpp
+++ b/Libraries/LibWeb/DOM/Document.cpp
@@ -4818,7 +4818,12 @@ bool Document::has_a_style_sheet_that_is_blocking_scripts() const
     //          deferred or module scripts. Blocking child document scripts on the container document's style sheets
     //          makes iframes needlessly wait for the embedding page's CSS, so match Blink and WebKit by only
     //          considering our own set.
-    return !m_script_blocking_style_sheet_set.is_empty();
+    if (!m_script_blocking_style_sheet_set.is_empty())
+        return true;
+
+    // AD-HOC: A style sheet isn't loaded until its @import-ed sheets are, so a pending @import blocks scripts too, as
+    //         it does rendering (see is_render_blocked()).
+    return !m_pending_css_import_rules.is_empty();
 }
 
 void Document::set_referrer(Utf16String referrer)
@@ -11198,8 +11203,11 @@ void Document::add_pending_css_import_rule(Badge<CSS::StyleSheetImport>, Nonnull
 void Document::remove_pending_css_import_rule(Badge<CSS::StyleSheetImport>, NonnullRefPtr<CSS::StyleSheetImport> rule)
 {
     m_pending_css_import_rules.remove(rule);
-    if (m_pending_css_import_rules.is_empty())
+    if (m_pending_css_import_rules.is_empty()) {
+        // NB: Pending @imports block scripts (see has_a_style_sheet_that_is_blocking_scripts()), so wake the parser.
+        schedule_html_parser_end_check();
         page().client().request_frame();
+    }
 }
 
 void Document::exit_pointer_lock()
