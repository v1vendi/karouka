 namespace Web::DOM {
 
+// AD-HOC: A pointer event's hit test reads the compositor's animations off the visual context tree, sampled at the time
+//         the compositor samples them (prepare_hit_test_query()), so the event's layout update leaves them unsampled on
+//         the main thread when every throttled effect is one of them. An effect throttled off screen or while invisible
+//         has no sample in the tree, and with one of those the update samples them all, as before. Otherwise every mouse
+//         move over a page with a running compositor animation restyled its targets and laid the document out.
+static bool reason_hit_tests_through_visual_animation_samples(UpdateLayoutReason reason)
+{
+    switch (reason) {
+    case UpdateLayoutReason::EventHandlerHandleDragAndDrop:
+    case UpdateLayoutReason::EventHandlerHandleMouseDown:
+    case UpdateLayoutReason::EventHandlerHandleMouseMove:
+    case UpdateLayoutReason::EventHandlerHandleMouseUp:
+    case UpdateLayoutReason::EventHandlerHandleMouseWheel:
+        return true;
+    default:
+        return false;
+    }
+}
+
+template<typename AnimationSet>
+static bool hit_test_reads_throttled_animations_off_the_visual_context_tree(UpdateLayoutReason reason, AnimationSet& animations)
+{
+    if (!reason_hit_tests_through_visual_animation_samples(reason))
+        return false;
+    for (auto& animation : animations) {
+        auto* effect = as_if<Animations::KeyframeEffect>(animation.effect().ptr());
+        if (!effect || !effect->can_skip_per_frame_style_update())
+            continue;
+        if (!effect->is_compositor_driven() && !effect->is_compositor_replaced())
+            return false;
+    }
+    return true;
+}
