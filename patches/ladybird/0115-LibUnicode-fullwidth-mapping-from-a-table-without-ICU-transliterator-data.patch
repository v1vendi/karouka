+
+static u16 fullwidth_code_unit(u16 code_unit)
+{
+    auto const* single = binary_search(ReadonlySpan<FullwidthSingle> { s_fullwidth_singles }, code_unit, nullptr, [](u16 needle, FullwidthSingle const& entry) {
+        return static_cast<int>(needle) - static_cast<int>(entry.code_unit);
+    });
+    return single ? single->fullwidth : code_unit;
+}
+
+static Optional<u16> fullwidth_composition(u16 code_unit, u16 sound_mark)
+{
+    if (sound_mark != 0xFF9E && sound_mark != 0xFF9F)
+        return {};
+    for (auto const& pair : s_fullwidth_pairs) {
+        if (pair.code_unit == code_unit && pair.sound_mark == sound_mark)
+            return pair.fullwidth;
+    }
+    return {};
+}
+
+static void append_fullwidth(Utf16View const& string, size_t start, size_t end, Vector<u16>& output)
+{
+    for (size_t i = start; i < end; ++i) {
+        auto code_unit = string.code_unit_at(i);
+        if (i + 1 < end) {
+            if (auto composed = fullwidth_composition(code_unit, string.code_unit_at(i + 1)); composed.has_value()) {
+                output.append(*composed);
+                ++i;
+                continue;
+            }
+        }
+        output.append(fullwidth_code_unit(code_unit));
+    }
+}
+
+Utf16String to_fullwidth(Utf16View const& string)
+{
+    Vector<u16> output;
+    output.ensure_capacity(string.length_in_code_units());
+    append_fullwidth(string, 0, string.length_in_code_units(), output);
+    return Utf16String::from_utf16({ reinterpret_cast<char16_t const*>(output.data()), output.size() });
+}
