+            //     which resolves it against the neighbouring fragments (line_bidi), instead of joining the space
+            //     before an Arabic word in a left-to-right paragraph to the Arabic.
+            (Some(known), None) | (None, Some(known)) if known == embedding_direction => known,
+            _ => line_box_fragment::GLYPH_TEXT_TYPE_CONTEXT_DEPENDENT,
         }
