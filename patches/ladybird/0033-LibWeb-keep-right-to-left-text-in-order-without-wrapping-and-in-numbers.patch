     }
 }
 
+// Whether a run is a number: European or Arabic digits, with only number separators, terminators and marks
+// between them. Such a run keeps its left-to-right order inside right-to-left text. Spaces may surround it (a run
+// that doesn't wrap keeps its spaces), but not split it: two numbers in a row are two units of the sequence.
+pub(crate) fn is_number_run(text: &[u16]) -> bool {
+    let is_space = |unit: &u16| *unit <= 0x7f && code_point_is_ascii_space(u32::from(*unit));
+    let Some(first) = text.iter().position(|unit| !is_space(unit)) else {
+        return false;
+    };
+    let last = text.iter().rposition(|unit| !is_space(unit)).unwrap();
+    let text = &text[first..=last];
+    // LibUnicode's BidiClass, in declaration order.
+    const AN: u8 = 0;
+    const CS: u8 = 3;
+    const NSM: u8 = 4;
+    const EN: u8 = 5;
+    const ES: u8 = 6;
+    const ET: u8 = 7;
+    let mut has_digit = false;
+    for code_point in char::decode_utf16(text.iter().copied()) {
+        let Ok(code_point) = code_point else {
+            return false;
+        };
+        // SAFETY: Pure Unicode table lookup.
+        match unsafe { unicode_layout_bidirectional_class(u32::from(code_point)) } {
+            AN | EN => has_digit = true,
+            CS | NSM | ES | ET => {}
+            _ => return false,
+        }
+    }
+    has_digit
+}
+
+// What a run that holds no digit but only number punctuation becomes next to a number (UAX #9 rules W4 and W5).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum NumberPunctuation {
+    // Only terminators ("%", "$", "#"): part of a number on either side.
+    Terminators,
+    // Separators too ("." "," "/" "+" "-"): part of a number only between two.
+    Separators,
+}
+
+pub(crate) fn number_punctuation_run(text: &[u16]) -> Option<NumberPunctuation> {
+    // LibUnicode's BidiClass, in declaration order.
+    const CS: u8 = 3;
+    const ES: u8 = 6;
+    const ET: u8 = 7;
+    let mut kind = NumberPunctuation::Terminators;
+    for code_point in char::decode_utf16(text.iter().copied()) {
+        let Ok(code_point) = code_point else {
+            return None;
+        };
+        // SAFETY: Pure Unicode table lookup.
+        match unsafe { unicode_layout_bidirectional_class(u32::from(code_point)) } {
+            ET => {}
+            CS | ES => kind = NumberPunctuation::Separators,
+            _ => return None,
+        }
+    }
+    (!text.is_empty()).then_some(kind)
+}
+
