diff --git a/Libraries/LibWebCommon/FileAPI/SerializedBlobURLEntry.cpp b/Libraries/LibWebCommon/FileAPI/SerializedBlobURLEntry.cpp
--- a/Libraries/LibWebCommon/FileAPI/SerializedBlobURLEntry.cpp
+++ b/Libraries/LibWebCommon/FileAPI/SerializedBlobURLEntry.cpp
@@ -27,6 +27,7 @@
 template<>
 ErrorOr<Web::FileAPI::SerializedBlobURLEntry> decode(Decoder& decoder)
 {
+#ifndef LIBWEB_PRUNE_MEDIASOURCEEXTENSIONS
     Web::FileAPI::SerializedBlobURLEntry::Object object = Web::FileAPI::SerializedBlobURLEntry::MediaSource {};
     if (TRY(decoder.decode<bool>())) {
         auto token = TRY(decoder.decode<URL::BlobURLEntry::Token>());
@@ -34,6 +35,15 @@
         auto data = TRY(decoder.decode<Core::AnonymousBuffer>());
         object = Web::FileAPI::SerializedBlobURLEntry::Blob { .token = token, .type = move(type), .data = move(data) };
     }
+#else
+    // karouka: without Media Source Extensions an entry that holds no Blob cannot be represented.
+    if (!TRY(decoder.decode<bool>()))
+        return Error::from_string_literal("Blob URL entry does not hold a Blob");
+    auto token = TRY(decoder.decode<URL::BlobURLEntry::Token>());
+    auto type = TRY(decoder.decode<String>());
+    auto data = TRY(decoder.decode<Core::AnonymousBuffer>());
+    Web::FileAPI::SerializedBlobURLEntry::Object object = Web::FileAPI::SerializedBlobURLEntry::Blob { .token = token, .type = move(type), .data = move(data) };
+#endif
     auto origin = TRY(decoder.decode<URL::Origin>());
     return Web::FileAPI::SerializedBlobURLEntry { .object = move(object), .origin = move(origin) };
 }
