diff --git a/Libraries/LibWeb/Embedder/HostClock.h b/Libraries/LibWeb/Embedder/HostClock.h
index ed578fe..9579698 100644
--- a/Libraries/LibWeb/Embedder/HostClock.h
+++ b/Libraries/LibWeb/Embedder/HostClock.h
@@ -28,6 +28,16 @@ namespace Web::Embedder {
 // Unix time at which the clock was installed plus the host time since, so Date.now() moves by what
 // performance.now() moves by, and performance.timeOrigin holds still.
 //
+// A script's reads of it take time. Within a task the host clock stands still, so a script that waits
+// for performance.now() or Date.now() to move would spin forever. Each read a window's script makes
+// (Performance::now, and on the main thread Date.now(), new Date() and Temporal.Now through the
+// window's Performance) returns at least script_read_step_ms after the previous read in the same
+// window, and never less than the host clock's time: a script's time is the host's, plus one step per
+// read it made since the host's time passed it. The step is fixed, so a busy wait ends after the same
+// number of reads on every run. Only script reads step: LibWeb's own reads (event timestamps, the
+// animation timeline, timers) stay on the host's time, which can then lag what a page read until the
+// host's time catches up (a 100 ms busy wait reads 100 ms ahead of the next six 16.67 ms frames).
+//
 // Installs the clock at now_ms (milliseconds on the host's monotonic clock). Installing it again only
 // sets its time. There is no uninstall: time origins and deadlines taken on one clock mean nothing on
 // the other.
@@ -48,6 +58,14 @@ double host_clock_time();
 double host_clock_wall_offset();
 double host_clock_wall_time();
 
+// The step, in milliseconds, each script read of the host clock takes (see above).
+constexpr double script_read_step_ms = 0.001;
+
+// A script's read of the host clock, for the reader whose next read may come no earlier than next_read
+// (Performance keeps it per window; it starts at zero): the later of the host clock's time and
+// next_read. Moves next_read one step past the time returned.
+double read_host_clock_for_script(double& next_read);
+
