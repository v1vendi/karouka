+bool DisplayListPlayerSkia::run_is_one_foldable_fill(u32 run_index) const
+{
+    auto runs = active_display_list().command_runs();
+    if (run_index >= runs.size())
+        return false;
+    size_t draw_count = 0;
+    bool foldable = true;
+    DisplayList::for_each_command_header(active_display_list().command_bytes_of_run(runs[run_index]), [&](DisplayListCommandHeader const& header, ReadonlyBytes payload) {
+        if (display_list_command_is_compositor_metadata(header.command_type))
+            return;
+        ++draw_count;
+        if (header.command_type == DisplayListCommandType::FillRectWithRoundedCorners)
+            return;
+        if (header.command_type == DisplayListCommandType::FillRect
+            && read_display_list_command_payload<FillRect>(payload).compositing_and_blending_operator == Gfx::CompositingAndBlendingOperator::Normal)
+            return;
+        foldable = false;
+    });
+    return foldable && draw_count == 1;
+}
+
+float DisplayListPlayerSkia::folded_opacity() const
+{
+    if (m_folded_opacities.is_empty())
+        return 1.0f;
+    return m_folded_opacities.last().opacity;
+}
+
 void DisplayListPlayerSkia::pop()
 {
     surface().canvas().restore();
+    while (!m_folded_opacities.is_empty() && m_folded_opacities.last().save_count > surface().canvas().getSaveCount())
+        m_folded_opacities.take_last();
 }
 
