diff --git a/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-filter.py b/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-filter.py
new file mode 100644
index 0000000000..816231f47f
--- /dev/null
+++ b/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-filter.py
@@ -0,0 +1,126 @@
+#!/usr/bin/env python3
+# karouka: package only the ICU data karouka uses (the "karouka-data" feature of this port).
+#
+# ICU's source release ships its data prebuilt (source/data/in/icudt78l.dat), without the text
+# sources ICU_DATA_FILTER_FILE needs. The data Makefile unpacks that archive into $(BUILDDIR) and
+# lists every item in icudata.lst, which pkgdata then links into libicudata
+# (karouka-data-filter.patch runs this script in between). This script:
+#   1. keeps the items matching a regex in karouka-data-keep.txt and rewrites icudata.lst, and
+#   2. regenerates each kept tree's res_index.res so that its InstalledLocales lists only the
+#      locales still present. icu::Locale::getAvailableLocales() reads it, and LibJS's Intl uses
+#      that to pick a locale: a dropped one (de-DE) then falls back to the default (en-US) instead
+#      of resolving to a locale whose data is missing.
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+LOCALE_FILE = re.compile(r"[a-z]{2,3}(?:_[A-Za-z0-9]+)*\.res")
+NOT_LOCALES = {"root.res", "pool.res", "res_index.res"}
+
+
+def read_keep_patterns(path):
+    patterns = []
+    with open(path) as file:
+        for line in file:
+            line = line.strip()
+            if line and not line.startswith("#"):
+                patterns.append(line)
+    return re.compile("|".join(f"(?:{pattern})" for pattern in patterns))
+
+
+def parse_res_index(dump):
+    """Parses derb's dump of a res_index.res into (cldr_version, aliases, installed)."""
+    cldr_version = None
+    sections = {"AliasLocales": [], "InstalledLocales": []}
+    section = None
+    for line in dump.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("//"):
+            continue
+        header = re.fullmatch(r"(\w+)\s*\{", stripped)
+        if header:
+            section = header.group(1) if header.group(1) in sections else None
+            continue
+        if stripped == "}":
+            section = None
+            continue
+        entry = re.fullmatch(r'(\S+)\s*\{\s*"([^"]*)"\s*\}', stripped)
+        if not entry:
+            continue
+        if section:
+            sections[section].append(entry.group(1))
+        elif entry.group(1) == "CLDRVersion":
+            cldr_version = entry.group(2)
+    return cldr_version, sections["AliasLocales"], sections["InstalledLocales"]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--list", required=True, help="icudata.lst, rewritten in place")
+    parser.add_argument("--data-dir", required=True, help="where the archive was unpacked")
+    parser.add_argument("--tool-dir", required=True, help="the build's bin (derb, genrb)")
+    parser.add_argument("--invoke", default="", help="ICU's $(INVOKE) prefix for its tools")
+    parser.add_argument(
+        "--keep",
+        default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "karouka-data-keep.txt"),
+    )
+    args = parser.parse_args()
+
+    keep = read_keep_patterns(args.keep)
+    with open(args.list) as file:
+        items = [line.strip() for line in file if line.strip()]
+    kept = [item for item in items if keep.fullmatch(item)]
+    kept_set = set(kept)
+
+    def tool(name):
+        return f"{args.invoke} {os.path.join(args.tool_dir, name)}"
+
+    for index in [item for item in kept if os.path.basename(item) == "res_index.res"]:
+        tree = os.path.dirname(index)
+        tree_dir = os.path.join(args.data_dir, tree)
+        dump = subprocess.run(
+            f"{tool('derb')} -c -s {tree_dir} res_index.res",
+            shell=True, check=True, capture_output=True, text=True,
+        ).stdout
+        cldr_version, aliases, installed = parse_res_index(dump)
+
+        def present(locale):
+            return os.path.join(tree, locale + ".res") in kept_set
+
+        lines = ["res_index:table(nofallback) {"]
+        if cldr_version:
+            lines.append(f'    CLDRVersion {{ "{cldr_version}" }}')
+        for name, locales in (("AliasLocales", aliases), ("InstalledLocales", installed)):
+            lines.append(f"    {name} {{")
+            lines += [f'        {locale} {{ "" }}' for locale in locales if present(locale)]
+            lines.append("    }")
+        lines.append("}")
+
+        listed = set(aliases) | set(installed)
+        for item in kept:
+            name = os.path.basename(item)
+            if os.path.dirname(item) == tree and LOCALE_FILE.fullmatch(name) and name not in NOT_LOCALES:
+                if name[:-4] not in listed:
+                    sys.exit(f"karouka-data-filter: {item} is kept but not in {index}")
+
+        with tempfile.TemporaryDirectory() as source_dir:
+            with open(os.path.join(source_dir, "res_index.txt"), "w") as file:
+                file.write("\n".join(lines) + "\n")
+            subprocess.run(
+                f"{tool('genrb')} -q -k -s {source_dir} -d {tree_dir} res_index.txt",
+                shell=True, check=True,
+            )
+
+    with open(args.list, "w") as file:
+        file.write("\n".join(kept) + "\n")
+
+    total = sum(os.path.getsize(os.path.join(args.data_dir, item)) for item in kept)
+    print(f"karouka-data-filter: kept {len(kept)} of {len(items)} ICU data items, {total} bytes")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-keep.txt b/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-keep.txt
new file mode 100644
index 0000000000..1fe596ab52
--- /dev/null
+++ b/Meta/CMake/vcpkg/overlay-ports/icu/karouka-data-keep.txt
@@ -0,0 +1,28 @@
+# karouka: the ICU data items karouka-data-filter.py keeps, one regex per line, matched against the
+# whole item name as icupkg lists it ("brkitr/line.brk"). Anything else is left out of libicudata.
+
+# Locales: root and English only. Other locales fall back to the default locale (en-US).
+(root|en|en_[A-Za-z0-9_]+|pool|res_index)\.res
+(brkitr|coll|curr|lang|rbnf|region|translit|unit|zone)/(root|en|en_[A-Za-z0-9_]+|pool|res_index)\.res
+# The languages with their own case mappings (SpecialCasing: Turkish, Azeri, Lithuanian; ICU also
+# uppercases Greek without accents). String.prototype.toLocaleLowerCase/UpperCase only apply them to
+# an available locale, so these four keep their main locale data (about 70 KB) but nothing else.
+(tr|az|lt|el)\.res
+
+# Locale-independent data: likely subtags and aliases, plurals, units, calendars and day periods
+# (supplementalData), numbering systems, and time zones for Temporal and Intl.DateTimeFormat.
+(supplementalData|langInfo|metadata|metaZones|timezoneTypes|windowsZones|zoneinfo64|plurals|pluralRanges|dayPeriods|numberingSystems|keyTypeData|units|grammaticalFeatures|genderList|currencyNumericCodes|icuver|icustd)\.res
+
+# Normalization beyond the NFC/NFD built into libicuuc (NFKC, case folding, UTS #46 for IDNA),
+# layout and emoji properties, and the converter alias table.
+(nfkc|nfkc_cf|nfkc_scf|uts46)\.nrm
+(ulayout|uemoji|cnvalias)\.icu
+
+# Collation root (Intl.Collator, localeCompare).
+coll/ucadata\.icu
+
+# Segmentation: grapheme, word, line and sentence rules, plus the dictionaries line breaking needs
+# for Thai, Lao, Khmer and Burmese. The CJK word dictionary (cjdict, 2 MB) is left out: CJK line
+# breaking doesn't use it; for word segmentation a run of CJK text becomes one word.
+brkitr/(char|line|sent|title|word|word_POSIX)\.brk
+brkitr/(thai|lao|khmer|burmese)dict\.dict
