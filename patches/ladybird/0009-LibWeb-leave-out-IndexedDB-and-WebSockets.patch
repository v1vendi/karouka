+++ b/Libraries/LibWeb/Embedder/Prune/WebSockets.cmake
@@ -0,0 +1,3 @@
+# karouka: WebSockets. The engine opens no sockets (patch 0002), so every WebSocket would only fail.
+# `WebSocket` is not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES WebSockets)
