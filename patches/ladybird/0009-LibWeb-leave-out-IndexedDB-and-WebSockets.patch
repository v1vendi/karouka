@@ -0,0 +1,3 @@
+# karouka: IndexedDB. The engine renders pages into textures with no profile directory, so there is
+# nothing for a database to persist into. `indexedDB` is not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES IndexedDB)
