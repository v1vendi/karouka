diff --git a/Libraries/LibWeb/Embedder/HostClock.cpp b/Libraries/LibWeb/Embedder/HostClock.cpp
new file mode 100644
index 0000000000..6ea5fe6074
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/HostClock.cpp
@@ -0,0 +1,202 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Atomic.h>
+#include <AK/QuickSort.h>
+#include <AK/RefCounted.h>
+#include <AK/Time.h>
+#include <AK/Vector.h>
+#include <LibCore/EventLoop.h>
+#include <LibGC/Cell.h>
+#include <LibGC/Root.h>
+#include <LibJS/Runtime/Temporal/Now.h>
+#include <math.h>
+#include <LibWeb/Embedder/HostClock.h>
+
+namespace Web::Embedder {
+
+namespace {
+
+// Ref-counted so that a firing keeps its own entry alive while the timer it fires cancels or moves it.
+struct ScheduledTimer : public RefCounted<ScheduledTimer> {
+    GC::Cell* cell { nullptr };
+    double due { 0 };
+    i32 interval_ms { 0 };
+    bool repeating { false };
+    u64 sequence { 0 };
+    Function<void()> fire;
+};
+
+struct HostClock {
+    bool installed { false };
+    double now { 0 };
+    u64 next_sequence { 0 };
+    bool pass_queued { false };
+    Vector<NonnullRefPtr<ScheduledTimer>> timers;
+    // The wall clock: the Unix time at which the host clock read zero, taken when it was installed, plus its time.
+    i64 wall_offset_ns { 0 };
+};
+
+// The host clock's wall time in nanoseconds since the Unix epoch, for LibJS's Date, which may read it off the main
+// thread (Temporal::set_host_wall_clock).
+Atomic<i64> s_wall_now_ns { 0 };
+
+i64 wall_now_ns()
+{
+    return s_wall_now_ns.load(AK::MemoryOrder::memory_order_relaxed);
+}
+
+// Never destroyed: a timer finalized during exit()'s static destructors may still cancel itself.
+HostClock& clock()
+{
+    static auto* host_clock = new HostClock;
+    return *host_clock;
+}
+
+Optional<size_t> index_of(GC::Cell const& cell)
+{
+    auto& timers = clock().timers;
+    for (size_t i = 0; i < timers.size(); ++i) {
+        if (timers[i]->cell == &cell)
+            return i;
+    }
+    return {};
+}
+
+// Fires the timers due at the clock's time, earliest deadline first and, at one deadline, in the
+// order they were scheduled. Each fires at most once per pass: a repeating timer that is due again
+// at once (a zero interval, or a host step longer than its interval) fires on the next pass, so a
+// pass always ends.
+void fire_due_timers()
+{
+    auto& host_clock = clock();
+    struct Due {
+        GC::Root<GC::Cell> cell;
+        double due;
+        u64 sequence;
+    };
+    Vector<Due> due;
+    for (auto& timer : host_clock.timers) {
+        if (timer->due <= host_clock.now)
+            due.append({ GC::make_root(timer->cell), timer->due, timer->sequence });
+    }
+    quick_sort(due, [](Due const& a, Due const& b) {
+        return a.due < b.due || (a.due == b.due && a.sequence < b.sequence);
+    });
+
+    for (auto& firing : due) {
+        // A timer an earlier firing of this pass stopped or moved is not due any more (moving it
+        // gives it a new sequence).
+        auto index = host_clock.timers.find_first_index_if([&](auto& timer) { return timer->sequence == firing.sequence; });
+        if (!index.has_value())
+            continue;
+        NonnullRefPtr<ScheduledTimer> timer = host_clock.timers[*index];
+        if (timer->repeating) {
+            // Keeps to its schedule; one that fell behind skips the firings it missed, as a
+            // repeating Core::Timer does.
+            timer->due += max(timer->interval_ms, 0);
+            if (timer->due <= host_clock.now)
+                timer->due = host_clock.now + max(timer->interval_ms, 0);
+        } else {
+            host_clock.timers.remove(*index);
+        }
+        timer->fire();
+    }
+}
+
+}
+
+void install_host_clock(double now_ms)
+{
+    auto& host_clock = clock();
+    if (host_clock.installed) {
+        set_host_clock_time(now_ms);
+        return;
+    }
+    host_clock.installed = true;
+    host_clock.now = now_ms;
+    host_clock.wall_offset_ns = UnixDateTime::now().nanoseconds_since_epoch() - static_cast<i64>(llround(now_ms * 1e6));
+    s_wall_now_ns.store(host_clock.wall_offset_ns + static_cast<i64>(llround(now_ms * 1e6)));
+    JS::Temporal::set_host_wall_clock(wall_now_ns);
+}
+
+void set_host_clock_time(double now_ms)
+{
+    auto& host_clock = clock();
+    if (!host_clock.installed)
+        return;
+    host_clock.now = max(host_clock.now, now_ms);
+    s_wall_now_ns.store(host_clock.wall_offset_ns + static_cast<i64>(llround(host_clock.now * 1e6)));
+    fire_due_timers();
+}
+
+Optional<double> next_host_clock_deadline()
+{
+    auto& host_clock = clock();
+    Optional<double> next;
+    for (auto& timer : host_clock.timers) {
+        if (timer->due > host_clock.now && (!next.has_value() || timer->due < *next))
+            next = timer->due;
+    }
+    return next;
+}
+
+bool host_clock_is_installed()
+{
+    return clock().installed;
+}
+
+double host_clock_time()
+{
+    return clock().now;
+}
+
+double host_clock_wall_offset()
+{
+    return static_cast<double>(clock().wall_offset_ns) / 1e6;
+}
+
+double host_clock_wall_time()
+{
+    return static_cast<double>(wall_now_ns()) / 1e6;
+}
+
+void schedule_on_host_clock(GC::Cell& cell, i32 interval_ms, bool repeating, Function<void()> fire)
+{
+    auto& host_clock = clock();
+    cancel_on_host_clock(cell);
+    auto timer = adopt_ref(*new ScheduledTimer);
+    timer->cell = &cell;
+    timer->due = host_clock.now + max(interval_ms, 0);
+    timer->interval_ms = interval_ms;
+    timer->repeating = repeating;
+    timer->sequence = host_clock.next_sequence++;
+    timer->fire = move(fire);
+    host_clock.timers.append(move(timer));
+
+    // A timer due now fires on the event loop's next turn, as a zero-delay Core::Timer would; one due
+    // later waits for the host to move the clock.
+    if (interval_ms <= 0 && !host_clock.pass_queued) {
+        host_clock.pass_queued = true;
+        Core::deferred_invoke([] {
+            clock().pass_queued = false;
+            fire_due_timers();
+        });
+    }
+}
+
+void cancel_on_host_clock(GC::Cell const& cell)
+{
+    if (auto index = index_of(cell); index.has_value())
+        clock().timers.remove(*index);
+}
+
+bool is_scheduled_on_host_clock(GC::Cell const& cell)
+{
+    return index_of(cell).has_value();
+}
+
+}
