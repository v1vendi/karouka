new file mode 100644
index 0000000000..ed578fe77a
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/HostClock.h
@@ -0,0 +1,57 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Function.h>
+#include <AK/Optional.h>
+#include <AK/Types.h>
+#include <LibGC/Forward.h>
+#include <LibWeb/Export.h>
+
+namespace Web::Embedder {
+
+// A clock the embedder drives, in place of the shared monotonic clock. Once installed, LibWeb's
+// unsafe shared current time (HighResolutionTime::unsafe_shared_current_time, which performance.now(),
+// time origins, timer deadlines and the animation timeline read) is the host's time, and it moves
+// only when the host sets it: it stands still between two calls. EventLoop::rendering_opportunity
+// takes the host's frame time as it is, without clamping it to the real clock, and HTML::Timer runs
+// on this clock instead of a Core::Timer: a timer fires when the host's time reaches its deadline,
+// not when real time does. So a host that steps its time by a fixed amount per frame gets the same
+// frames whatever the frames cost. It is for the main thread's event loop; nothing else may read it.
+//
+// The wall clock moves with it: once installed, Date (Date.now(), new Date(); through
+// JS::Temporal::set_host_wall_clock), Temporal.Now and the wall clock's unsafe current time read the
+// Unix time at which the clock was installed plus the host time since, so Date.now() moves by what
+// performance.now() moves by, and performance.timeOrigin holds still.
+//
+// Installs the clock at now_ms (milliseconds on the host's monotonic clock). Installing it again only
+// sets its time. There is no uninstall: time origins and deadlines taken on one clock mean nothing on
+// the other.
+WEB_API void install_host_clock(double now_ms);
+
+// Moves the host clock to now_ms (never back: an earlier time is ignored), then fires every timer
+// due by then, in deadline order. Firing a timer queues its task; the event loop runs it.
+WEB_API void set_host_clock_time(double now_ms);
+
+// The earliest deadline after the clock's time of a timer scheduled on it, if any: the host moves the
+// clock there (set_host_clock_time) for the timer to fire at its own time, not at the host's next
+// step after it. A timer due at the clock's time fires on the event loop's next turn and is not one.
+WEB_API Optional<double> next_host_clock_deadline();
+
+bool host_clock_is_installed();
+double host_clock_time();
+// The Unix time, in milliseconds, at which the host clock reads zero, and the Unix time it reads now.
+double host_clock_wall_offset();
+double host_clock_wall_time();
+
+// For HTML::Timer. A timer is scheduled at most once; scheduling it again moves it. `cell` is kept
+// rooted while a firing is under way, so that the firing of another timer can't collect it.
+void schedule_on_host_clock(GC::Cell& cell, i32 interval_ms, bool repeating, Function<void()> fire);
+void cancel_on_host_clock(GC::Cell const& cell);
+bool is_scheduled_on_host_clock(GC::Cell const& cell);
+
+}
