--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/Serial.cmake
@@ -0,0 +1,3 @@
+# karouka: the Web Serial API. A texture renderer has no serial ports to offer. `navigator.serial`
+# and SerialPort are not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES Serial)
diff --git a/Libraries/LibWeb/Embedder/Prune/WebLocks.cmake b/Libraries/LibWeb/Embedder/Prune/WebLocks.cmake
new file mode 100644
index 0000000000..a4d13c30e7
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/WebLocks.cmake
@@ -0,0 +1,3 @@
+# karouka: the Web Locks API. Each view is one document with no workers or other tabs to coordinate
+# with. `navigator.locks`, LockManager and Lock are not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES WebLocks)
diff --git a/Libraries/LibWeb/Embedder/Prune/WebXR.cmake b/Libraries/LibWeb/Embedder/Prune/WebXR.cmake
new file mode 100644
index 0000000000..921aee48fd
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/WebXR.cmake
@@ -0,0 +1,5 @@
+# karouka: WebXR. A page rendered into a texture has no XR device. `navigator.xr` and the XR*
+# interfaces are not exposed, and neither are the internals' fake XR device and XRTest.
+list(APPEND LIBWEB_PRUNED_FAMILIES WebXR)
+list(FILTER SOURCES EXCLUDE REGEX "^Internals/(FakeXRDevice|XRTest)\\.cpp$")
+list(APPEND LIBWEB_PRUNED_IDL Internals/FakeXRDevice Internals/XRTest)
