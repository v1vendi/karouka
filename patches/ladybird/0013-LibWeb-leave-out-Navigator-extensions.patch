--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/CredentialManagement.cmake
@@ -0,0 +1,3 @@
+# karouka: the Credential Management API. There is no password manager or identity provider behind a
+# texture renderer. `navigator.credentials` and the *Credential interfaces are not exposed.
+list(APPEND LIBWEB_PRUNED_FAMILIES CredentialManagement)
