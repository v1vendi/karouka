+// An update_layout() that would find nothing to do is skipped. What it finds to do is what makes a layout geometry read
+// unclean, plus what it does after its pass: a scroll container resnap that a commit scheduled, and the first snapshot of
+// a scroll-state() query container. Throttled animations are sampled first, as update_layout() would for the reason.
+bool Document::update_layout_if_needed(UpdateLayoutReason reason)
+{
+    auto navigable = this->navigable();
+    if (!navigable || navigable->active_document().ptr() != this)
+        return false;
+
+    {
+        // NB: Whether the update finds style or layout pending is asked behind the style transaction that flew, which
+        //     lands for the read.
+        Layout::ForcedReadScope read { style_computer().style_engine().render_document() };
+        drain_flown_style_transaction(read);
+
+        if (reason != UpdateLayoutReason::HTMLEventLoopRenderingUpdate && reason != UpdateLayoutReason::ChildDocumentStyleUpdate)
+            flush_throttled_animation_style_update();
+
+        if (is_clean_for_layout_geometry_read(read)
+            && !m_needs_scroll_container_resnap
+            && !m_scroll_state_query_containers.has_containers())
+            return false;
+    }
+
+    update_layout(reason);
+    return true;
+}
+
 // The first round of the rendering update's layout reads the document's facts as they are before its style flies, and
 // runs after the style in the frame. List items that wait to be renumbered and top layer work are the layout update's
 // to do first, so nothing is sealed while either waits.
