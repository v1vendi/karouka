-#include <LibWeb/WebAssembly/WebAssembly.h>
+#ifndef LIBWEB_PRUNE_WEBASSEMBLY
+#    include <LibWeb/WebAssembly/WebAssembly.h>
+#endif
 #include <LibWeb/WebIDL/AbstractOperations.h>
 #include <LibWeb/WebIDL/ExceptionOrUtils.h>
 #include <LibWebCommon/Page/QueuedInputEvent.h>
@@ -706,6 +708,7 @@ void initialize_main_thread_vm(HTML::AgentType type)
         dbgln("Unable to parse date string: \"{}\"", date);
     };
 
+#ifndef LIBWEB_PRUNE_WEBASSEMBLY
     main_thread_vm_ptr()->host_resize_array_buffer = [default_host_resize_array_buffer = move(main_thread_vm_ptr()->host_resize_array_buffer)](JS::ArrayBuffer& buffer, size_t new_byte_length) -> JS::ThrowCompletionOr<JS::HandledByHost> {
         auto wasm_handled = TRY(WebAssembly::Detail::host_resize_array_buffer(*main_thread_vm_ptr(), buffer, new_byte_length));
         if (wasm_handled == JS::HandledByHost::Handled)
@@ -721,6 +724,7 @@ void initialize_main_thread_vm(HTML::AgentType type)
 
         return default_host_grow_shared_array_buffer(buffer, new_byte_length);
     };
+#endif
 }
 
 JS::VM& main_thread_vm()
diff --git a/Libraries/LibWeb/CMakeLists.txt b/Libraries/LibWeb/CMakeLists.txt
index 496061aa45..dc2a96cb1d 100644
--- a/Libraries/LibWeb/CMakeLists.txt
+++ b/Libraries/LibWeb/CMakeLists.txt
@@ -1199,7 +1199,11 @@ set(GENERATED_SOURCES
 ladybird_lib(LibWeb web EXPLICIT_SYMBOL_EXPORT)
 target_link_libraries(LibWeb PUBLIC LibCompositing LibWebCommon)
 
-target_link_libraries(LibWeb PRIVATE LibCore LibCompress LibCrypto LibJS LibHTTP LibGfx LibIPC LibRegex LibSyntax LibTextCodec LibUnicode LibMedia LibMediaClient LibWasm LibXML LibURL LibRequests LibGC LibImageDecoderClient LibThreading skia LibXml2::LibXml2)
+target_link_libraries(LibWeb PRIVATE LibCore LibCompress LibCrypto LibJS LibHTTP LibGfx LibIPC LibRegex LibSyntax LibTextCodec LibUnicode LibMedia LibMediaClient LibXML LibURL LibRequests LibGC LibImageDecoderClient LibThreading skia LibXml2::LibXml2)
+# karouka: Embedder/Prune/WebAssembly.cmake leaves LibWasm out.
+if (NOT LIBWEB_PRUNE_WEBASSEMBLY)
+    target_link_libraries(LibWeb PRIVATE LibWasm)
+endif()
 
 # LibWeb still includes ANGLE's GLES headers for WebGL constants and types, but
 # the actual GL entry points live in the Compositor. Copy only ANGLE's compile
