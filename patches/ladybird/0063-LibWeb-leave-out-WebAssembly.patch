diff --git a/Libraries/LibWeb/Embedder/Prune/WebAssembly.cmake b/Libraries/LibWeb/Embedder/Prune/WebAssembly.cmake
new file mode 100644
index 0000000000..86b591d1c1
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/WebAssembly.cmake
@@ -0,0 +1,7 @@
+# karouka: WebAssembly (the `WebAssembly` namespace and its Module, Instance, Memory, Table and Global
+# interfaces), with LibWasm behind it: about 1.9 MB of code. Pages that render into textures don't
+# run wasm. `typeof WebAssembly` is "undefined", as in a browser without it; a module script served as
+# application/wasm creates no module script (HTML/Scripting/Fetching.cpp), so its import fails.
+# LibWeb's CMakeLists.txt leaves LibWasm off LibWeb's link line when LIBWEB_PRUNE_WEBASSEMBLY is set.
+list(APPEND LIBWEB_PRUNED_FAMILIES WebAssembly)
+set(LIBWEB_PRUNE_WEBASSEMBLY ON)
