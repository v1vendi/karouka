--- /dev/null
+++ b/Libraries/LibWeb/Embedder/FileFetch.h
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2026, the karouka authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/Export.h>
+
+namespace Web::Embedder {
+
+// Lets requests without a destination (fetch(), among them) read file: URLs, still only for a
+// client whose own origin is a file: origin. Off by default, as upstream: scheme fetch serves file:
+// URLs to a file: page's subresource loads but never to fetch(). For an embedder that renders
+// local pages with no network, where reading another local file exfiltrates nothing.
+WEB_API void set_fetch_reads_file_urls(bool);
+bool fetch_reads_file_urls();
+
+}
