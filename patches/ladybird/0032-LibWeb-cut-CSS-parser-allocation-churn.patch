+/// The input's length without its comments, for sizing the token vector: comments produce no
+/// tokens, and the user-agent sheet is one-third comments, so sizing by the whole length reserved
+/// ~1.6x the tokens it needs (a 3.8 MB vector for 2.4 MB of tokens). Strings are skipped so a `/*`
+/// inside one isn't taken for a comment. Only a capacity hint: an unterminated string or comment
+/// just makes the estimate smaller, and the vector grows if it has to.
+fn uncommented_length<T: Copy + Into<u32>>(units: &[T]) -> usize {
+    let mut comment_length = 0;
+    let mut index = 0;
+    let unit = |index: usize| units.get(index).map(|&unit| unit.into());
+    while let Some(current) = unit(index) {
+        if current == u32::from(b'/') && unit(index + 1) == Some(u32::from(b'*')) {
+            let start = index;
+            index += 2;
+            while let Some(current) = unit(index) {
+                index += 1;
+                if current == u32::from(b'*') && unit(index) == Some(u32::from(b'/')) {
+                    index += 1;
+                    break;
+                }
+            }
+            comment_length += index - start;
+            continue;
+        }
+        if current == u32::from(b'"') || current == u32::from(b'\'') {
+            index += 1;
+            while let Some(next) = unit(index) {
+                index += 1;
+                if next == u32::from(b'\\') {
+                    index += 1;
+                } else if next == current || next == u32::from(b'\n') {
+                    break;
+                }
+            }
+            continue;
+        }
+        index += 1;
+    }
+    units.len() - comment_length
+}
