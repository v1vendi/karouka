+/// The capacity to reserve for `count` parse-tree items: `count` rounded up to a power of two. An
+/// exact size would put vectors of every length in a different allocator size class, and each class
+/// touched dirties its own pages; powers of two are the sizes the regrown vectors used to end at, so
+/// the tree still lands in the same few classes, without the regrowth's intermediate copies.
+pub(crate) fn binned_capacity(count: usize) -> usize {
+    if count == 0 { 0 } else { count.next_power_of_two() }
+}
+
+/// How many component values a list consumer gets from `tokens[position..]` before the first
+/// top-level token `stop` accepts (or the end). Functions and simple blocks count once and are
+/// skipped to their closing token, as `consume_a_component_value` does. Callers reserve this many
+/// values up front, so a long declaration value (a counter style's `symbols`, a selector list) is
+/// one allocation instead of a chain of regrown, freed vectors.
+pub(crate) fn count_component_values(
+    tokens: &[ParserToken],
+    mut position: usize,
+    stop: impl Fn(&ParserTokenKind) -> bool,
+) -> usize {
+    let mut count = 0;
+    while let Some(token) = tokens.get(position) {
+        if stop(&token.kind) {
+            break;
+        }
+        position = skip_a_component_value(tokens, position, 0);
+        count += 1;
+    }
+    count
+}
+
+/// The position just past the component value that starts at `position`.
+pub(crate) fn skip_a_component_value(tokens: &[ParserToken], position: usize, depth: usize) -> usize {
+    let Some(token) = tokens.get(position) else {
+        return position;
+    };
+    let closes = |kind: &ParserTokenKind| match token.kind {
+        ParserTokenKind::Function(_) | ParserTokenKind::OpenParen => matches!(kind, ParserTokenKind::CloseParen),
+        ParserTokenKind::OpenSquare => matches!(kind, ParserTokenKind::CloseSquare),
+        _ => matches!(kind, ParserTokenKind::CloseCurly),
+    };
+    if !matches!(
+        token.kind,
+        ParserTokenKind::Function(_)
+            | ParserTokenKind::OpenParen
+            | ParserTokenKind::OpenSquare
+            | ParserTokenKind::OpenCurly
+    ) {
+        return position + 1;
+    }
+    let mut position = position + 1;
+    while let Some(next) = tokens.get(position) {
+        if closes(&next.kind) {
+            return position + 1;
+        }
+        // Past the nesting limit the consumer fails anyway; keep the walk flat there.
+        position = if depth < MAXIMUM_COMPONENT_VALUE_NESTING_DEPTH {
+            skip_a_component_value(tokens, position, depth + 1)
+        } else {
+            position + 1
+        };
+    }
+    position
+}
+
