+fn paint_content_border_image_slice<O: Observer>(
+    recorder: &mut PaintRecorder<'_, O>,
+    content: &ContentSource,
+    source_size: CssPixelSize,
+    source_rect: FloatRect,
+    dest_rect: IntRect,
+    tiling: &SliceTiling,
+    image_rendering: u8,
+) {
+    let converter = recorder.converter;
+    if tiling.tile_count_x == Some(1) && tiling.tile_count_y == Some(1) {
+        let clip = intersect_float_rects(tiling.first_tile, dest_rect.to_float());
+        draw_content_source_region(
+            &mut recorder.recorder,
+            converter,
+            content,
+            source_size,
+            source_rect,
+            tiling.first_tile,
+            clip,
+        );
+        return;
+    }
+
+    // Record the slice once as a tile and let the player repeat its raster over the destination.
+    let tile_size = IntSize {
+        width: 1.max(tiling.first_tile.width.round_ties_even() as i32),
+        height: 1.max(tiling.first_tile.height.round_ties_even() as i32),
+    };
+    let tile_rect = FloatRect::new(0.0, 0.0, tile_size.width as f32, tile_size.height as f32);
+    let group = recorder.recorder.begin_repeated_tile();
+    draw_content_source_region(
+        &mut recorder.recorder,
+        converter,
+        content,
+        source_size,
+        source_rect,
+        tile_rect,
+        tile_rect,
+    );
+    let scaling_mode = to_gfx_scaling_mode(
+        image_rendering,
+        (tile_size.width, tile_size.height),
+        (tile_size.width, tile_size.height),
+    );
+    recorder.recorder.finish_repeated_tile(
+        group,
+        tiling.first_tile,
+        dest_rect,
+        tile_size,
+        tiling.tile_step,
+        scaling_mode,
+        CompositingAndBlendingOperator::Normal,
+        Repeat {
+            x: tiling.tile_count_x != Some(1),
+            y: tiling.tile_count_y != Some(1),
+        },
+    );
+}
