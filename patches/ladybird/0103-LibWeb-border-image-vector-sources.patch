+/// A border image source with no frame to sample: it is recorded once at its source size, and every slice
+/// draws that one recording, so content runs continuously across the slices.
+enum ContentSource {
+    Vector {
+        display_list_id: DisplayListResourceId,
+        list_size: IntSize,
+    },
+    Gradient {
+        paint: ResolvedGradientPaint,
+        raster_size: IntSize,
+    },
+}
