+/// Draws the part `source_rect` (CSS px of a source `source_size` CSS px large) of `content` onto
+/// `target` (device px), clipped to `clip`.
+fn draw_content_source_region(
+    recorder: &mut crate::painting::display_list::recorder::DisplayListRecorder,
+    converter: crate::painting::display_list::device_pixels::DevicePixelConverter,
+    content: &ContentSource,
+    source_size: CssPixelSize,
+    source_rect: FloatRect,
+    target: FloatRect,
+    clip: FloatRect,
+) {
+    if source_rect.is_empty() || target.is_empty() || clip.is_empty() {
+        return;
+    }
+    let scale_x = target.width / source_rect.width;
+    let scale_y = target.height / source_rect.height;
+    let placement = FloatRect::new(
+        target.x - source_rect.x * scale_x,
+        target.y - source_rect.y * scale_y,
+        source_size.width.to_float() * scale_x,
+        source_size.height.to_float() * scale_y,
+    );
+    if placement.is_empty() {
+        return;
+    }
+    recorder.record_with_inline_clips(&[PendingInlineClip::intersecting_float_rect(clip)], |recorder| {
+        match content {
+            ContentSource::Vector {
+                display_list_id,
+                list_size,
+            } => recorder.paint_nested_display_list(*display_list_id, placement, *list_size),
+            ContentSource::Gradient { paint, raster_size } => {
+                let clip_rect = libgfx_rust::enclosing_int_rect(clip);
+                if clip_rect.is_empty() {
+                    return;
+                }
+                // The gradient is rasterized once at its source size; each slice draws a scaled part of that raster.
+                let group = recorder.begin_repeated_tile();
+                record_resolved_gradient_fill(
+                    recorder,
+                    converter,
+                    paint,
+                    FloatRect::new(0.0, 0.0, raster_size.width as f32, raster_size.height as f32),
+                    CompositingAndBlendingOperator::Normal,
+                    ForceDarkRole::Border,
+                );
+                recorder.finish_repeated_tile(
+                    group,
+                    placement,
+                    clip_rect,
+                    *raster_size,
+                    FloatSize {
+                        width: placement.width,
+                        height: placement.height,
+                    },
+                    ScalingMode::Bilinear,
+                    CompositingAndBlendingOperator::Normal,
+                    Repeat { x: false, y: false },
+                );
+            }
+        }
+    });
+}
