From: Illia Komsa <ik@fungamer.co>
Subject: [PATCH] LibWeb: forget the font cascades no computed style holds

FontCascadeMemo remembers the cascade every font request resolved to for
the document's lifetime. A page that animates font-size (a transition, or a
script stepping it) resolves a new cascade at every size it passes, and each
holds fonts with their own typeface clone (an optical-size variation),
HarfBuzz face and font, and CoreText/Skia objects, so memory grew without
bound: 2400 fractional sizes held ~85 MB of system malloc.

A computed style holds a reference to its cascade (FontCascadeListHandle),
so one only the memo holds is used by no element. Before a style
transaction gathers its inputs, once the memo holds twice what it kept the
last time (and more than 64), FontComputer::forget_unused_font_cascades()
takes a new font environment generation and forgets those, as
did_load_font() forgets stale ones: the engine's resolver cache answers only
for the generation it was filled at, and the forgotten cascades are retired
until the engine resolves against the new one. Cascades waiting on a face
stay, and nothing is forgotten beside a flown transaction or inside a font
face change batch.

diff --git a/Libraries/LibWeb/CSS/FontComputer.cpp b/Libraries/LibWeb/CSS/FontComputer.cpp
index b35b11b..0c32016 100644
--- a/Libraries/LibWeb/CSS/FontComputer.cpp
+++ b/Libraries/LibWeb/CSS/FontComputer.cpp
@@ -536,6 +536,29 @@ void FontComputer::did_end_flown_style_drain()
         record_font_input_changes(move(uses_changed_fonts));
 }
 
+// A page that animates font-size resolves a new cascade at every size it passes through, each with fonts that carry their
+// own HarfBuzz and platform font data, and the memo kept every one for the document's lifetime: a size transition grew
+// memory without bound. A computed style holds a reference to its cascade (FontCascadeListHandle), so a cascade only
+// the memo holds is used by no element, and resolving its request again gives an equal one. So once the memo holds
+// twice what it kept when it last forgot some (and more than a few dozen), those are forgotten. Like did_load_font(), it
+// takes a new font environment generation: the engine names the memo's cascades without references while one stands,
+// and the forgotten ones are retired until the engine resolves against the new one.
+void FontComputer::forget_unused_font_cascades()
+{
+    constexpr size_t cascades_kept_without_forgetting = 64;
+    if (m_font_cascade_memo->size() <= max(cascades_kept_without_forgetting, m_font_cascades_kept_at_last_forget * 2))
+        return;
+    // A cascade a flown transaction resolved may not be held yet, and inside a batch the generation waits for its end.
+    if (m_font_face_change_batch_depth > 0 || document().has_flown_style_transaction())
+        return;
+    bump_environment_generation();
+    m_font_cascade_memo->forget_matching(m_environment_generation, [](auto const&, NonnullRefPtr<Gfx::FontCascadeList const> const& font_list) {
+        // NB: A cascade waiting on a face stays, so that did_load_font() finds the elements that resolve it again.
+        return font_list->ref_count() == 1 && !font_list->has_pending_faces();
+    });
+    m_font_cascades_kept_at_last_forget = m_font_cascade_memo->size();
+}
+
 // Every change to what a font resolution would answer passes through here. Nothing else may touch
 // m_environment_generation.
 void FontComputer::bump_environment_generation()
diff --git a/Libraries/LibWeb/CSS/FontComputer.h b/Libraries/LibWeb/CSS/FontComputer.h
index f7ae5a2..9a033d7 100644
--- a/Libraries/LibWeb/CSS/FontComputer.h
+++ b/Libraries/LibWeb/CSS/FontComputer.h
@@ -201,6 +201,9 @@ public:
     void did_change_system_fonts();
     // The style transaction that flew has been drained, so the styles it computed are the elements' own.
     void did_end_flown_style_drain();
+    // Forgets the remembered cascades no computed style holds, once there are many more than when it last did. Called
+    // before a style transaction gathers its inputs.
+    void forget_unused_font_cascades();
 
     void register_font_face(NonnullRefPtr<FontFaceState>);
     void unregister_font_face(NonnullRefPtr<FontFaceState>);
@@ -255,6 +258,8 @@ private:
     bool m_has_completed_initial_paint { false };
     bool m_initial_paint_had_pending_fonts { false };
     u32 m_font_face_change_batch_depth { 0 };
+    // How many cascades the memo kept when forget_unused_font_cascades() last forgot some.
+    size_t m_font_cascades_kept_at_last_forget { 0 };
     u64 m_environment_generation { 1 };
     mutable RefPtr<FontFaceSnapshot const> m_font_face_snapshot;
     Vector<Utf16FlyString> m_batched_font_face_change_families;
diff --git a/Libraries/LibWeb/CSS/FontResolution.cpp b/Libraries/LibWeb/CSS/FontResolution.cpp
index 92f5477..06a108f 100644
--- a/Libraries/LibWeb/CSS/FontResolution.cpp
+++ b/Libraries/LibWeb/CSS/FontResolution.cpp
@@ -475,6 +475,12 @@ void FontCascadeMemo::forget_matching(u64 environment_generation, Function<bool(
     });
 }
 
+size_t FontCascadeMemo::size() const
+{
+    MutexLocker locker(m_mutex);
+    return m_cascades.size();
+}
+
 void FontCascadeMemo::release_retired() const
 {
     // NB: A cascade's destructor releases fonts into the document thread's caches, so it runs outside the lock.
diff --git a/Libraries/LibWeb/CSS/FontResolution.h b/Libraries/LibWeb/CSS/FontResolution.h
index 37a4eda..cc8b13d 100644
--- a/Libraries/LibWeb/CSS/FontResolution.h
+++ b/Libraries/LibWeb/CSS/FontResolution.h
@@ -79,6 +79,8 @@ public:
     // Releases the retired cascades, on the document thread, where the engine is about to resolve against the newest
     // table: what it named from older ones is never read again.
     void release_retired() const;
+    // How many cascades the memo remembers.
+    [[nodiscard]] size_t size() const;
 
     struct ResolutionAgainstOlderTable {
         ComputedFontCacheKey key;
diff --git a/Libraries/LibWeb/CSS/StyleEngineBridge.cpp b/Libraries/LibWeb/CSS/StyleEngineBridge.cpp
index 565dae1..54f6fe3 100644
--- a/Libraries/LibWeb/CSS/StyleEngineBridge.cpp
+++ b/Libraries/LibWeb/CSS/StyleEngineBridge.cpp
@@ -865,6 +865,9 @@ void StyleEngine::gather_computation_inputs(Layout::BegunRead const& read, LentC
 StyleEngine::PublishedStyleTransaction StyleEngine::take_style_transaction(Layout::BegunRead const& read, StyleNodeID root)
 {
     auto submission_started_at = MonotonicTime::now();
+    // Before the inputs name the font environment generation, which forgetting cascades changes.
+    if (m_style_computer)
+        m_style_computer->document().font_computer().forget_unused_font_cascades();
     submit_recorded_input();
     LentComputationInputs lent;
     gather_computation_inputs(read, lent);
@@ -977,6 +980,7 @@ bool StyleEngine::let_style_transaction_fly(Layout::BegunRead const& read, Style
 {
     if (!m_style_computer)
         return false;
+    m_style_computer->document().font_computer().forget_unused_font_cascades();
     submit_recorded_input();
     LentComputationInputs lent;
     gather_computation_inputs(read, lent);
