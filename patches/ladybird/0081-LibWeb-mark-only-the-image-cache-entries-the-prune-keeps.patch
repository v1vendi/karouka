+// karouka: an image cache (this list, or a document's shared resource requests) marks only
+// the entries that Document::prune_image_resource_caches would keep if every client of every entry
+// went away in this collection: the most recently used ones within its limits. An entry beyond them
+// is dropped in this collection if nothing else reaches its data (remove_dead_cells() below, or
+// SharedResourceRequest::finalize for the document's map), instead of after the next one: data in
+// use is kept alive by its clients (a live <img> reaches it through its image request), and unused
+// data beyond the limits is what the prune would drop anyway.
+//
+// Marking every entry, as upstream does, keeps the pixels of a replaced <img> through the collection
+// that finalizes it: the prune skips entries with clients, so it could drop them only after that
+// collection, and another collection would be needed to free them. Since data that survives a
+// collection without clients is within the prune's limits, nothing needs to prune after one: the
+// prune runs when an image finishes loading.
+//
+// Where the prune differs: it keeps unused data within its limits without counting data still in
+// use. When images loaded after an unused one stay in use, this marking counts them and may drop
+// that unused data in this collection where the prune would have kept it, so a later load of its
+// URL fetches and decodes it again.
+void ListOfAvailableImages::visit_cached_images(JS::Cell::Visitor& visitor, Span<CachedImage> images)
+{
+    quick_sort(images, [](auto const& a, auto const& b) { return a.cache_touch_serial > b.cache_touch_serial; });
+    size_t size = 0;
+    size_t count = 0;
+    for (auto& image : images) {
+        size += image.image_data->external_memory_size();
+        ++count;
+        if (size <= decoded_image_cache_limit && count <= decoded_image_cache_count_limit)
+            visitor.visit(image.cell);
+    }
+}
+
 void ListOfAvailableImages::visit_edges(JS::Cell::Visitor& visitor)
 {
     Base::visit_edges(visitor);
+    Vector<CachedImage, 32> images;
+    images.ensure_capacity(m_images.size());
     for (auto& it : m_images)
-        visitor.visit(it.value->image_data);
+        images.unchecked_append({ it.value->image_data, it.value->image_data, it.value->cache_touch_serial });
+    visit_cached_images(visitor, images);
+}
+
+void ListOfAvailableImages::remove_dead_cells(Badge<GC::Heap>)
+{
+    m_images.remove_all_matching([](auto const&, auto const& entry) { return !entry->image_data->is_marked(); });
 }
 
