 # the plain data types (tracks, codec strings, time ranges, video frame plumbing) LibWeb and
 # LibCompositing compile against, with no decoders, demuxers, ffmpeg or Audio/VideoToolbox. Media
 # elements still parse, lay out and fire their load algorithm; nothing ever decodes or plays.
-if (KAROUKA_SOURCE_DIR)
-    set(LADYBIRD_MEDIA_STUB_DEFAULT ON)
-else()
-    set(LADYBIRD_MEDIA_STUB_DEFAULT OFF)
-endif()
-option(LADYBIRD_MEDIA_STUB "Build LibMedia/LibMediaClient as a no-playback stub without ffmpeg" ${LADYBIRD_MEDIA_STUB_DEFAULT})
-
+# The LADYBIRD_MEDIA_STUB option is declared in the top-level CMakeLists.txt, before project(), so
+# that vcpkg leaves ffmpeg out too.
 if (LADYBIRD_MEDIA_STUB)
     set(SOURCES
         Audio/AudioDevices.cpp
