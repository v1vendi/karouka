diff --git a/CMakeLists.txt b/CMakeLists.txt
index bd610119fa..45da77512d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,6 +16,21 @@ if (APPLE AND NOT CMAKE_OSX_DEPLOYMENT_TARGET)
     set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0)
 endif()
 
+# karouka: embedders that never play media build LibMedia as a stub without ffmpeg
+# (Libraries/LibMedia/CMakeLists.txt). Decided here, before project(), because that is where the
+# vcpkg toolchain installs the manifest: a stub build installs it without its default "media"
+# feature, so vcpkg neither builds nor installs ffmpeg, and check_for_dependencies.cmake doesn't
+# look for it.
+if (KAROUKA_SOURCE_DIR)
+    set(LADYBIRD_MEDIA_STUB_DEFAULT ON)
+else()
+    set(LADYBIRD_MEDIA_STUB_DEFAULT OFF)
+endif()
+option(LADYBIRD_MEDIA_STUB "Build LibMedia/LibMediaClient as a no-playback stub without ffmpeg" ${LADYBIRD_MEDIA_STUB_DEFAULT})
+if (LADYBIRD_MEDIA_STUB)
+    set(VCPKG_MANIFEST_NO_DEFAULT_FEATURES ON)
+endif()
+
 # Pass additional information to vcpkg if we are using it.
 if (CMAKE_TOOLCHAIN_FILE MATCHES "vcpkg.cmake$")
     set(CMAKE_PROJECT_ladybird_INCLUDE_BEFORE "Meta/CMake/vcpkg/generate_vcpkg_toolchain_variables.cmake")
