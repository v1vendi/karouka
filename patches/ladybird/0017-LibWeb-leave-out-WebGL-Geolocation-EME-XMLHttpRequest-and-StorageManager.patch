diff --git a/Libraries/LibWeb/Embedder/Prune/StorageManager.cmake b/Libraries/LibWeb/Embedder/Prune/StorageManager.cmake
new file mode 100644
index 0000000000..e39d692d6d
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/StorageManager.cmake
@@ -0,0 +1,6 @@
+# karouka: the Storage API's StorageManager (`navigator.storage`). StorageKey, StorageShelf and
+# StorageBottle back localStorage, BroadcastChannel and blob URLs, so only NavigatorStorage and
+# StorageManager go. StorageManager is not a directory, so this only defines LIBWEB_PRUNE_STORAGEMANAGER.
+list(APPEND LIBWEB_PRUNED_FAMILIES StorageManager)
+list(FILTER SOURCES EXCLUDE REGEX "^StorageAPI/(NavigatorStorage|StorageManager)\\.cpp$")
+list(APPEND LIBWEB_PRUNED_IDL StorageAPI/NavigatorStorage StorageAPI/StorageManager)
diff --git a/Libraries/LibWeb/Embedder/Prune/WebGL.cmake b/Libraries/LibWeb/Embedder/Prune/WebGL.cmake
new file mode 100644
index 0000000000..c9a24fcf2e
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/WebGL.cmake
@@ -0,0 +1,6 @@
+# karouka: WebGL. Canvases render into the page's display list; there is no compositor process to
+# run GL commands in. getContext("webgl"/"webgl2") returns null, as in a browser without WebGL, and
+# the canvas context Variants keep only their 2D alternative. WebGL/WebGLContextProxy.cpp is a
+# generated source, so it is excluded here rather than by the SOURCES filter.
+list(APPEND LIBWEB_PRUNED_FAMILIES WebGL)
+set_source_files_properties(WebGL/WebGLContextProxy.cpp PROPERTIES HEADER_FILE_ONLY ON)
diff --git a/Libraries/LibWeb/Embedder/Prune/XMLHttpRequest.cmake b/Libraries/LibWeb/Embedder/Prune/XMLHttpRequest.cmake
new file mode 100644
index 0000000000..3d7953e2d6
--- /dev/null
+++ b/Libraries/LibWeb/Embedder/Prune/XMLHttpRequest.cmake
@@ -0,0 +1,6 @@
+# karouka: XMLHttpRequest. There is no network; pages use fetch, which rejects. FormData and
+# ProgressEvent stay in XHR/ because forms, Fetch and FileReader use them. XMLHttpRequest is not a
+# directory, so this only defines LIBWEB_PRUNE_XMLHTTPREQUEST.
+list(APPEND LIBWEB_PRUNED_FAMILIES XMLHttpRequest)
+list(FILTER SOURCES EXCLUDE REGEX "^XHR/XMLHttpRequest(EventTarget|Upload)?\\.cpp$")
+list(APPEND LIBWEB_PRUNED_IDL XHR/XMLHttpRequest XHR/XMLHttpRequestEventTarget XHR/XMLHttpRequestUpload)
