+// karouka: a shader() image's uniform arguments (pairs of a dashed ident and its computed value in the
+// Rust data) as the embedder takes them.
+static Vector<Embedder::ShaderArgument> shader_arguments_from_rust_data(StyleValueFFI::RetainedStyleValueData const& retained_list)
+{
+    auto const* list_data = static_cast<StyleValueFFI::StyleValueData const*>(retained_list.pointer);
+    if (!list_data)
+        return {};
+    auto const& list = list_data->value_list.values;
+    auto child = [&](size_t index) {
+        auto const* data = static_cast<StyleValueFFI::StyleValueData const*>(list.pointer[index].pointer);
+        return StyleValue::adopt_rust_style_value_data(StyleValueFFI::rust_style_value_retain(data));
+    };
+    Vector<Embedder::ShaderArgument> arguments;
+    for (size_t index = 0; index + 1 < list.length; index += 2) {
+        auto name = child(index);
+        if (!name->is_custom_ident())
+            continue;
+        Embedder::ShaderArgument argument;
+        argument.name = name->as_custom_ident().custom_ident().to_utf16_string().to_utf8_but_should_be_ported_to_utf16();
+        auto value = child(index + 1);
+        if (value->is_number()) {
+            argument.type = Embedder::ShaderArgument::Type::Number;
+            argument.values[0] = static_cast<float>(value->as_number().number());
+        } else if (value->is_percentage()) {
+            argument.type = Embedder::ShaderArgument::Type::Percentage;
+            argument.values[0] = static_cast<float>(value->as_percentage().percentage().as_fraction());
+        } else if (value->is_length()) {
+            if (auto length = value->as_length().length(); length.is_absolute()) {
+                argument.type = Embedder::ShaderArgument::Type::Length;
+                argument.values[0] = length.absolute_length_to_px().to_float();
+            }
+        } else if (value->is_value_list()) {
+            auto values = value->as_value_list().values();
+            if (values.size() == 2 && values[0]->is_number() && values[1]->is_number()) {
+                argument.type = Embedder::ShaderArgument::Type::NumberPair;
+                argument.values[0] = static_cast<float>(values[0]->as_number().number());
+                argument.values[1] = static_cast<float>(values[1]->as_number().number());
+            }
+        } else if (value->has_color()) {
+            // FIXME: currentcolor and light-dark() need the element's color and scheme, which this doesn't have.
+            if (auto color = value->to_color({}); color.has_value()) {
+                argument.type = Embedder::ShaderArgument::Type::Color;
+                argument.values = { color->red() / 255.f, color->green() / 255.f, color->blue() / 255.f, color->alpha() / 255.f };
+            }
+        }
+        arguments.append(move(argument));
+    }
+    return arguments;
+}
