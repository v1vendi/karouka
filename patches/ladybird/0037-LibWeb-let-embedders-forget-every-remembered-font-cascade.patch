From: Illia Komsa <ik@fungamer.co>
Subject: [PATCH] LibWeb: let embedders forget every remembered font cascade

FontComputer remembers the cascade each font-family list resolved to, and
forgets one only when a face of a family it names loads (did_load_font). A
generic family (serif, sans-serif, monospace, system-ui...) or a family no
@font-face rule defines resolves through the system font provider instead,
so an embedder that changes what those resolve to after load (a host default
font) had no way to reach a live document: its cascades stayed on the old
font. Add FontComputer::did_change_system_fonts(): resolve every remembered
cascade again, forget the ones that answer differently and restyle the
elements holding them, as did_load_font does for one face.

diff --git a/Libraries/LibWeb/CSS/FontComputer.cpp b/Libraries/LibWeb/CSS/FontComputer.cpp
index 8b8d5d5f89..09f59a1579 100644
--- a/Libraries/LibWeb/CSS/FontComputer.cpp
+++ b/Libraries/LibWeb/CSS/FontComputer.cpp
@@ -647,6 +647,33 @@ void FontComputer::did_load_font(FontFaceKey const& changed_face)
     request_wanted_web_faces();
 }
 
+void FontComputer::did_change_system_fonts()
+{
+    bump_environment_generation();
+    // Unlike one face loading, the change is not to a family a cascade names: generic families and families no
+    // @font-face rule defines resolve through the system font provider, so every remembered cascade is resolved again,
+    // and the elements holding one that answers differently now are restyled.
+    HashTable<Gfx::FontCascadeList const*> invalidated_font_lists;
+    Vector<NonnullRefPtr<Gfx::FontCascadeList const>> invalidated_font_lists_kept_alive_for_the_walk;
+    RefPtr<FontFaceSnapshot const> snapshot;
+    m_font_cascade_memo->forget_matching(m_environment_generation, [&](auto const& key, auto const& font_list) {
+        if (!snapshot)
+            snapshot = font_face_snapshot();
+        auto updated_font_list = resolve_font_cascade(*snapshot, key, font_feature_values_provider(key.font_feature_values_scope));
+        if (!font_list->has_pending_faces() && font_list->equals(*updated_font_list))
+            return false;
+        invalidated_font_lists.set(font_list.ptr());
+        invalidated_font_lists_kept_alive_for_the_walk.append(font_list);
+        return true;
+    });
+    if (!invalidated_font_lists.is_empty()) {
+        record_font_input_changes([invalidated_font_lists = move(invalidated_font_lists), kept_alive = move(invalidated_font_lists_kept_alive_for_the_walk)](DOM::Element const& element) {
+            return element_uses_any_font_list(element, invalidated_font_lists);
+        });
+    }
+    request_wanted_web_faces();
+}
+
 void FontComputer::begin_font_face_change_batch()
 {
     ++m_font_face_change_batch_depth;
diff --git a/Libraries/LibWeb/CSS/FontComputer.h b/Libraries/LibWeb/CSS/FontComputer.h
index 11ccdf877a..f7ae5a2b9a 100644
--- a/Libraries/LibWeb/CSS/FontComputer.h
+++ b/Libraries/LibWeb/CSS/FontComputer.h
@@ -196,6 +196,9 @@ public:
     void clear_font_feature_values_cache(Utf16FlyString const& family_name);
     void did_load_font(Utf16FlyString const& family_name);
     void did_load_font(FontFaceKey const&);
+    // NB: For embedders whose system font provider changed what a generic or unknown family resolves to (a new
+    //     default font): every remembered cascade may answer differently now.
+    void did_change_system_fonts();
     // The style transaction that flew has been drained, so the styles it computed are the elements' own.
     void did_end_flown_style_drain();
 
