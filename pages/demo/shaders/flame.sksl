// A raymarched flame, after "Flame" by anatole duprat - XT95/2013 (shadertoy.com/view/MdX3zr), licensed CC BY-NC-SA 3.0.
// The flame is the shell of a stretched sphere whose surface noise grows with height; the march counts how long the
// ray has been inside it and that count is the glow. Changes for DOM use: the box holds `tongues` flames side by
// side, each with its own noise (`seed` plus its index) and height, and the night around them is transparent, so
// the fire composites over whatever is behind the element. The view is pulled back so the base sits at the bottom and
// the tips fade out before the top. `cool` turns the orange wood fire into a blue gas flame.
uniform float2 uSize;
uniform float uTime;
uniform float seed;
uniform float tongues;
uniform float cool;

const float PI = 3.14159265;

float noise(float3 p) {   // thanks to Las^Mercury
    float3 i = floor(p);
    float4 a = dot(i, float3(1.0, 57.0, 21.0)) + float4(0.0, 57.0, 21.0, 78.0);
    float3 f = cos((p - i) * PI) * -0.5 + 0.5;
    a = mix(sin(cos(a) * a), sin(cos(1.0 + a) * (1.0 + a)), f.x);
    a.xy = mix(a.xz, a.yw, f.y);
    return mix(a.x, a.y, f.z);
}
float flame(float3 p, float3 o) {
    float d = length(p * float3(1.0, 0.5, 1.0) - float3(0.0, -1.0, 0.0)) - 1.0;
    return d + (noise(p + o + float3(0.0, uTime * 2.0, 0.0)) + noise((p + o) * 3.0) * 0.5) * 0.25 * p.y;
}

half4 main(float2 c) {
    float n = max(floor(tongues + 0.5), 1.0), w = uSize.x / n;
    float k = floor(c.x / w);
    float h = fract(sin(k * 12.9898 + seed * 78.233) * 43758.5453);   // this tongue's own height
    float2 v = float2(2.0 * (c.x - k * w) / w - 1.0, 2.0 * c.y / uSize.y - 1.0);
    v.x *= w / uSize.y;
    v.y = (v.y + 1.0) * (n > 1.0 ? 0.8 + 0.35 * h : 1.0) - 1.0;   // a taller tongue: its rays reach further up
    float3 org = float3(0.0, -2.0, 4.0), dir = normalize(float3(v.x * 1.5, 1.45 * v.y - 0.55, -1.5));
    float3 o = float3(seed * 7.31 + k * 3.7, 0.0, seed * 3.13 + k * 1.9);

    float3 p = org;
    float glow = 0.0;
    bool glowed = false;
    for (int i = 0; i < 64; i++) {
        float d = min(100.0 - length(p), abs(flame(p, o))) + 0.02;
        p += d * dir;
        if (d > 0.02) {
            if (flame(p, o) < 0.0) glowed = true;
            if (glowed) glow = float(i) / 64.0;
        }
    }
    float3 col = mix(float3(1.0, 0.5, 0.1), float3(0.15, 0.45, 1.0), clamp(cool, 0.0, 1.0));
    float g = pow(glow * 2.0, 4.0) * smoothstep(0.0, 0.3, c.y / uSize.y);
    // the original mixes from black: premultiplied, that's the colour times the glow with the glow as alpha
    return half4(half3(min(col * g, 1.0)), min(g, 1.0));
}
