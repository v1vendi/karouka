// Endless smooth-coloured Mandelbrot zoom into the seahorse valley.
uniform float2 uSize;
uniform float uTime;

half4 main(float2 coord) {
    float2 uv = (coord - 0.5 * uSize) / uSize.y;
    float zoom = exp(-mod(uTime * 0.35, 9.0));
    float2 c = float2(-0.743643887, 0.131825904) + uv * 2.5 * zoom;
    float2 z = float2(0);
    float n = 0.0;
    bool esc = false;
    for (int i = 0; i < 300; i++) {
        z = float2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
        if (dot(z, z) > 256.0) { esc = true; break; }
        n += 1.0;
    }
    if (!esc) return half4(0, 0, 0, 1);
    float sn = n - log2(log2(dot(z, z))) + 4.0;
    float3 col = 0.5 + 0.5 * cos(3.0 + sn * 0.12 + float3(0.0, 0.6, 1.0));
    return half4(half3(col), 1);
}
