// Raymarched SDF scene: a blended sphere/torus over a checker floor, soft shadows and AO.
uniform float2 uSize;
uniform float uTime;

float sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }
float smin(float a, float b, float k) { float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0); return mix(b, a, h) - k * h * (1.0 - h); }

float map(float3 p) {
    float c = cos(uTime * 0.7), s = sin(uTime * 0.7);
    float3 q = float3(c * p.x - s * p.y, s * p.x + c * p.y, p.z) - float3(0, 0.0, 0);
    float3 tp = p - float3(0, 1.0, 0);
    float3 tq = float3(tp.x, c * tp.y - s * tp.z, s * tp.y + c * tp.z);
    float torus = sdTorus(tq, float2(0.9, 0.25));
    float sphere = length(p - float3(0, 1.0 + 0.5 * sin(uTime * 1.3), 0)) - 0.55;
    float floor = p.y;
    return min(smin(torus, sphere, 0.35), floor);
}

float3 normal(float3 p) {
    float e = 0.001;
    return normalize(float3(map(p + float3(e, 0, 0)) - map(p - float3(e, 0, 0)),
                            map(p + float3(0, e, 0)) - map(p - float3(0, e, 0)),
                            map(p + float3(0, 0, e)) - map(p - float3(0, 0, e))));
}

float shadow(float3 ro, float3 rd) {
    float res = 1.0, t = 0.02;
    for (int i = 0; i < 32; i++) {
        float h = map(ro + rd * t);
        res = min(res, 8.0 * h / t);
        t += clamp(h, 0.02, 0.3);
        if (res < 0.001 || t > 6.0) break;
    }
    return clamp(res, 0.0, 1.0);
}

half4 main(float2 coord) {
    float2 uv = (coord - 0.5 * uSize) / uSize.y * float2(1, -1);
    float a = uTime * 0.25;
    float3 ro = float3(3.2 * sin(a), 1.6, 3.2 * cos(a));
    float3 fw = normalize(float3(0, 0.8, 0) - ro);
    float3 rt = normalize(cross(fw, float3(0, 1, 0)));
    float3 up = cross(rt, fw);
    float3 rd = normalize(fw * 1.6 + rt * uv.x + up * uv.y);

    float t = 0.0;
    bool hit = false;
    for (int i = 0; i < 90; i++) {
        float d = map(ro + rd * t);
        if (d < 0.001) { hit = true; break; }
        t += d;
        if (t > 20.0) break;
    }
    float3 sky = mix(float3(0.9, 0.6, 0.45), float3(0.25, 0.4, 0.75), clamp(uv.y * 1.5 + 0.4, 0.0, 1.0));
    float3 col = sky;
    if (hit) {
        float3 p = ro + rd * t;
        float3 n = normal(p);
        float3 l = normalize(float3(0.6, 0.8, 0.3));
        float3 mat = p.y < 0.002 ? mix(float3(0.15), float3(0.8), mod(floor(p.x) + floor(p.z), 2.0))
                                 : 0.5 + 0.5 * cos(float3(0, 2, 4) + p.y * 2.0 + uTime);
        float dif = max(dot(n, l), 0.0) * shadow(p + n * 0.01, l);
        float ao = clamp(map(p + n * 0.15) / 0.15, 0.0, 1.0);
        float spec = pow(max(dot(reflect(rd, n), l), 0.0), 32.0);
        col = mat * (0.2 * ao * sky + 1.1 * dif * float3(1.0, 0.95, 0.85)) + 0.5 * spec * dif;
        col = mix(col, sky, 1.0 - exp(-0.008 * t * t));
    }
    col = pow(col, float3(0.4545));
    return half4(half3(col), 1);
}
