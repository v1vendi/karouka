// Liquid glass over a procedural backdrop, all in one shader. backdrop() is the scene behind the glass: drifting
// color blobs, diagonal stripes, a dot grid and a set of rings. The glass is one SDF, a card, a toolbar, a lens and
// two droplets joined with smooth-min so the droplets melt into the toolbar as they pass. Inside it the backdrop is
// evaluated at bent coordinates: pulled along the edge normal (most near the rim), split by wavelength and frosted
// with four taps, then tinted and lit with a specular rim. Outside, the backdrop gets the glass's soft shadow.
uniform float2 uSize;
uniform float uTime;

float box(float2 p, float2 c, float2 b, float r) {
    float2 q = abs(p - c) - b + r;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float smin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float3 backdrop(float2 p) {
    float t = uTime * 0.4;
    float3 col = mix(float3(0.04, 0.06, 0.16), float3(0.11, 0.04, 0.16), clamp(p.x / uSize.x, 0.0, 1.0));
    float2 c0 = float2(0.15 * uSize.x + 60.0 * sin(t * 1.3), 0.80 * uSize.y + 30.0 * cos(t));
    float2 c1 = float2(0.45 * uSize.x + 80.0 * cos(t * 0.9), 0.20 * uSize.y + 40.0 * sin(t * 1.1));
    float2 c2 = float2(0.70 * uSize.x + 70.0 * sin(t * 0.7), 0.85 * uSize.y + 30.0 * sin(t * 1.4));
    float2 c3 = float2(0.90 * uSize.x + 40.0 * cos(t * 1.2), 0.30 * uSize.y + 60.0 * cos(t * 0.8));
    col += float3(0.85, 0.32, 0.16) * exp(-dot(p - c0, p - c0) / 22000.0);
    col += float3(0.80, 0.12, 0.50) * exp(-dot(p - c1, p - c1) / 18000.0);
    col += float3(0.10, 0.60, 0.85) * exp(-dot(p - c2, p - c2) / 26000.0);
    col += float3(0.85, 0.65, 0.15) * exp(-dot(p - c3, p - c3) / 16000.0);
    col += 0.035 * step(0.5, fract((p.x + p.y) / 26.0));
    float2 g = fract(p / 22.0) - 0.5;
    col += 0.16 * smoothstep(0.16, 0.10, length(g));
    float d = length(p - float2(0.36 * uSize.x, 0.50 * uSize.y));
    col += 0.40 * smoothstep(2.0, 0.6, abs(fract(d / 20.0) - 0.5) * 20.0) * smoothstep(170.0, 150.0, d);
    return col;
}

// The shapes match the HTML laid over them (.glass-card, .glass-bar in the page's CSS).
float scene(float2 p) {
    float t = uTime;
    float card = box(p, float2(150.0, 92.0), float2(118.0, 64.0), 28.0);
    float bar = box(p, float2(0.5 * uSize.x, uSize.y - 56.0), float2(170.0, 30.0), 30.0);
    float2 a = float2(0.5 * uSize.x + 170.0 * sin(t * 0.7), uSize.y - 140.0 + 60.0 * sin(t * 1.1));
    float2 b = float2(0.5 * uSize.x + 130.0 * sin(t * 0.9 + 2.0), uSize.y - 115.0 + 55.0 * cos(t * 0.8));
    float drops = smin(length(p - a) - 26.0, length(p - b) - 19.0, 30.0);
    float lens = length(p - float2(uSize.x - 120.0, 120.0 + 24.0 * sin(t * 0.6))) - 70.0;
    return min(card, smin(smin(bar, drops, 36.0), lens, 40.0));
}

half4 main(float2 c) {
    float d = scene(c);
    float2 g = float2(scene(c + float2(1, 0)) - scene(c - float2(1, 0)), scene(c + float2(0, 1)) - scene(c - float2(0, 1)));
    float2 n = g / max(length(g), 1e-4);

    float shadow = 0.4 * exp(-max(scene(c - float2(0.0, 12.0)), 0.0) * 0.06);
    float3 outside = backdrop(c) * (1.0 - shadow);

    float edge = 1.0 - clamp(-d / 28.0, 0.0, 1.0);
    float k = edge * edge * 36.0;
    float3 col = float3(0);
    for (int i = 0; i < 4; i++) {
        float2 o = 2.5 * float2(cos(float(i) * 1.5708 + 0.785), sin(float(i) * 1.5708 + 0.785));
        col.r += backdrop(c + o - n * k).r;
        col.g += backdrop(c + o - n * k * 1.1).g;
        col.b += backdrop(c + o - n * k * 1.2).b;
    }
    col = mix(col / 4.0, float3(0.85, 0.9, 1.0), 0.10);
    float2 L = normalize(float2(-0.6, -0.8));
    float lit = max(dot(n, L), 0.0), back = max(dot(n, -L), 0.0);
    col += smoothstep(2.0, 0.0, -d) * (0.3 + 0.7 * lit);
    col += pow(edge, 5.0) * (0.35 * lit + 0.15 * back);

    float inside = smoothstep(0.75, -0.75, d);
    return half4(half3(clamp(mix(outside, col, inside), 0.0, 1.0)), 1);
}
