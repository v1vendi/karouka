// Noise dissolve. --mode 0: a mask (alpha only); --mode 1: the glowing burn edge, drawn on top.
// Both read the same noise and the same uTime, so the edge sits exactly on the mask's border.
uniform float2 uSize;
uniform float uTime;
uniform float mode;

float hash(float2 p) { return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453); }
float noise(float2 p) {
    float2 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1, 0)), f.x), mix(hash(i + float2(0, 1)), hash(i + float2(1, 1)), f.x), f.y);
}
float fbm(float2 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }
    return v;
}

half4 main(float2 coord) {
    float n = fbm(coord / 38.0);
    float th = 0.5 + 0.42 * sin(uTime * 0.9);
    if (mode < 0.5) {
        half a = half(smoothstep(th - 0.01, th + 0.01, n));
        return half4(a);
    }
    float e = exp(-abs(n - th) * 45.0);
    float3 c = mix(float3(1.0, 0.25, 0.05), float3(1.0, 0.9, 0.5), e);
    return half4(half3(c * e), half(e));
}
